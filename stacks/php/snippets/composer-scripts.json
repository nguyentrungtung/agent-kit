{
  "//": "agent-kit: merge into composer.json so humans and agents run the same commands.",
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "config": { "sort-packages": true, "optimize-autoloader": true },
  "scripts": {
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "stan": "phpstan analyse --no-progress",
    "arch": "deptrac analyse --no-progress",
    "test": "phpunit",
    "check": ["@cs", "@stan", "@arch", "@test"]
  }
}
