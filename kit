#!/usr/bin/env bash
# kit — agent-kit CLI. Packs every stack/module; `init` installs ONLY what you pick into a project.
#
#   kit init [dir] [options]      interactive picker (gum if installed, plain prompts otherwise)
#       --stack <spec>            stack[:path[:framework]][,…]   e.g. php::laravel  or  java-maven:backend:spring,node:frontend:react
#       --preset app|data|platform|minimal   module bundle (default app); --modules overrides it
#       --modules <list|default|all|none>   e.g. ba,sa,devops,security,openspec  (docker = alias of devops)
#       --services <list>         docker catalog services, e.g. postgres,redis   (needs module devops)
#       --name <n> --lang vi|en   --yes (accept defaults, install dev deps, run module setup)
#       --install-tools (install MISSING global tools without asking; never implied by --yes)
#       --no-deps --no-setup --no-tools --force (overwrite) --no-git
#       --provider github|gitlab|none|auto   where PRs/MRs, CI and issues live (auto: remote host, then .gitlab-ci.yml / .github/);
#                                 gitlab installs .gitlab-ci + MR/issue templates instead of .github/, none installs neither
#       --flow gitflow|trunk|auto   gitflow = tasks branch from develop; trunk = from main (auto: trunk when an existing repo has no develop)
#       --hooks auto|kit|keep     git hooks: kit = core.hooksPath → .githooks; keep = leave Husky/lefthook/… alone and chain the kit's
#                                 checks through .agent/scripts/kit-hook; auto (default) = keep when a manager is found, else kit
#       --mode auto|new|existing  existing = adopt a repo that already has code: the repo is the reference — only gates for tools it
#                                 already uses, commands taken from its CI, no tool config it does not have (auto: existing when the
#                                 repo has commits). new = the full kit set-up (every gate, every config)
#   kit add <module…> [--dir <project>] [--services …] [--yes]   add modules to an installed project
#   kit doctor [dir] [--run]      check tools/configs of an installed project
#   kit tools [dir] [install] [--yes]   tools the project needs; installs only the missing ones
#   kit upgrade [dir] [--allow-dirty]   re-apply this kit version: refresh untouched kit files, *.kit-new for edited ones
#   kit list                      stacks, frameworks, modules, docker services
set -euo pipefail

KIT_SRC="$(cd "$(dirname "$0")" && pwd)"
CORE="$KIT_SRC/core"; STACKS="$KIT_SRC/stacks"; MODULES="$KIT_SRC/modules"
VERSION="$(cat "$KIT_SRC/VERSION" 2>/dev/null || echo dev)"
STEPS="install format format_check lint typecheck arch test coverage build audit"
DETECT_ORDER="java-maven java-gradle php dbt python go rust dotnet node"

if [ -t 2 ]; then G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; B=$'\033[1m'; D=$'\033[2m'; N=$'\033[0m'; else G=; Y=; R=; B=; D=; N=; fi
say()  { printf '%s[kit]%s %s\n' "$G" "$N" "$*" >&2; }
note() { printf '%s[kit]%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s[kit] ERROR:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -e/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# ---------------------------------------------------------------- yaml-ish helpers
yget() { # yget <file> <key> — flat "key: value" (inline " # comment" stripped)
  [ -f "$1" ] || return 0
  sed -n "s/^$2:[[:space:]]*//p" "$1" | head -n1 | sed -E 's/[[:space:]]+#[[:space:]].*$//; s/[[:space:]]+$//'
}
yhas() { [ -f "$1" ] && grep -q "^$2:" "$1"; }
stack_yaml() { printf '%s/%s/stack.yaml' "$STACKS" "$1"; }
stack_parent() { yget "$(stack_yaml "$1")" inherit; }
stack_asset() { # stack_asset <stack> <relpath> — own asset, else inherited one
  local s="$1" rel="$2" p
  [ -e "$STACKS/$s/$rel" ] && { printf '%s' "$STACKS/$s/$rel"; return; }
  p="$(stack_parent "$s")"; [ -n "$p" ] && [ -e "$STACKS/$p/$rel" ] && printf '%s' "$STACKS/$p/$rel"
  return 0
}
fw_dir() { local d; d="$(stack_asset "$1" "frameworks/$2")"; printf '%s' "$d"; }
fw_list() { yget "$(stack_yaml "$1")" frameworks; }
all_stacks() { local d; for d in "$STACKS"/*/; do basename "$d"; done; }
all_modules() { local d; for d in "$MODULES"/*/; do basename "$d"; done; }
default_modules() { local m o=""; for m in $(all_modules); do [ "$(yget "$MODULES/$m/module.yaml" default)" = true ] && o="$o $m"; done; echo $o; }
PRESETS="app data platform minimal"
preset_modules() { # preset_modules <preset> → module list (only modules that exist)
  local want m o=""
  case "$1" in
    app)      want="ba sa api devops perf security openspec eng-skills codegraph" ;;
    data)     want="ba sa data devops security openspec eng-skills codegraph" ;;
    platform) want="devops security openspec eng-skills codegraph" ;;
    minimal)  want="openspec eng-skills codegraph" ;;
    *) die "unknown preset '$1' (app, data, platform, minimal)" ;;
  esac
  for m in $want; do [ -d "$MODULES/$m" ] && o="$o $m"; done; echo $o
}
preset_title() { case "$1" in app) echo "Web/API application — BA, SA, API contracts, DevOps, k6 perf smoke, Security, OpenSpec, engineering skills, CodeGraph";; data) echo "Data engineering — BA, SA, Data (dbt/Airflow/PySpark), DevOps, Security, OpenSpec data-flow";; platform) echo "Infrastructure / platform repo — DevOps, Security, OpenSpec, CodeGraph";; minimal) echo "Minimal — gates + OpenSpec + CodeGraph only";; esac; }
all_services() { local f; for f in "$MODULES"/devops/catalog/*.yml; do basename "$f" .yml; done; }
svc_meta() { sed -n "s/^# $2:[[:space:]]*//p" "$MODULES/devops/catalog/$1.yml" | head -n1; }

matches() { # matches <dir> "<spec spec…>"  spec = glob  |  file~regex
  local dir="$1" spec f re
  for spec in $2; do
    if [ "${spec#*~}" != "$spec" ]; then
      f="${spec%%~*}"; re="${spec#*~}"
      [ -f "$dir/$f" ] && grep -Eq "$re" "$dir/$f" && return 0
    else
      compgen -G "$dir/$spec" >/dev/null 2>&1 && return 0
    fi
  done
  return 1
}
detect_stack() { local s; for s in $DETECT_ORDER; do matches "$1" "$(yget "$(stack_yaml "$s")" detect)" && { echo "$s"; return; }; done; echo generic; }
detect_framework() { local fw d; for fw in $(fw_list "$2"); do d="$(fw_dir "$2" "$fw")"; matches "$1" "$(yget "$d/framework.yaml" detect)" && { echo "$fw"; return; }; done; echo ""; }
detect_components() { # prints "path=stack+fw …"
  local t="$1" root sub s out="" d
  root="$(detect_stack "$t")"
  if [ "$root" != generic ]; then out=".=$root+$(detect_framework "$t" "$root")"; fi
  for d in "$t"/*/; do
    [ -d "$d" ] || continue
    sub="$(basename "$d")"
    case "$sub" in node_modules|vendor|docs|target|build|dist|.*) continue ;; esac
    s="$(detect_stack "$d")"
    [ "$s" = generic ] && continue
    [ "$s" = "$root" ] && continue
    out="$out $sub=$s+$(detect_framework "$d" "$s")"
  done
  out="$(echo $out)"
  echo "${out:-.=generic+}"
}

# ---------------------------------------------------------------- interactive UI (prompts on /dev/tty)
INTERACTIVE=0
in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
has_gum() { command -v gum >/dev/null 2>&1; }
ui_input() { # ui_input <prompt> <default>
  local a
  if has_gum; then gum input --prompt "$1: " --value "$2" </dev/tty; return; fi
  printf '%s?%s %s %s[%s]%s: ' "$B" "$N" "$1" "$D" "$2" "$N" >/dev/tty; IFS= read -r a </dev/tty || true
  echo "${a:-$2}"
}
ui_confirm() { # ui_confirm <prompt> <y|n>
  local a d="$2"
  if has_gum; then if [ "$d" = y ]; then gum confirm "$1" </dev/tty; else gum confirm --default=false "$1" </dev/tty; fi; return; fi
  printf '%s?%s %s %s[%s]%s: ' "$B" "$N" "$1" "$D" "$( [ "$d" = y ] && echo Y/n || echo y/N )" "$N" >/dev/tty
  IFS= read -r a </dev/tty || true; a="${a:-$d}"
  case "$a" in y|Y|yes) return 0 ;; *) return 1 ;; esac
}
ui_one() { # ui_one <prompt> <default> <opt…>   (opt may be "value — label")
  local p="$1" def="$2" i=1 o a; shift 2
  if has_gum; then
    local pre=""; for o in "$@"; do [ "${o%% — *}" = "$def" ] && { pre="$o"; break; }; done
    gum choose --header "$p" --selected "$pre" "$@" </dev/tty | sed 's/ — .*//'; return
  fi
  printf '%s?%s %s\n' "$B" "$N" "$p" >/dev/tty
  local mark
  for o in "$@"; do mark=""; [ "${o%% — *}" = "$def" ] && mark=" (default)"; printf '  %2d) %s%s\n' $i "$o" "$mark" >/dev/tty; i=$((i+1)); done
  printf '  choose [number, Enter = default]: ' >/dev/tty; IFS= read -r a </dev/tty || true
  if [ -z "$a" ]; then echo "$def"; return; fi
  i=1; for o in "$@"; do [ "$i" = "$a" ] && { echo "${o%% — *}"; return; }; i=$((i+1)); done
  echo "$def"
}
ui_many() { # ui_many <prompt> "<default values>" <opt…>  → space-separated values
  local p="$1" defs="$2" i=1 o a v sel="" n; shift 2
  if has_gum; then
    for o in "$@"; do v="${o%% — *}"; in_list "$v" "$defs" && sel="$sel$o,"; done
    gum choose --no-limit --header "$p (space = toggle, enter = ok)" --selected "${sel%,}" "$@" </dev/tty | sed 's/ — .*//' | tr '\n' ' '; echo; return
  fi
  printf '%s?%s %s\n' "$B" "$N" "$p" >/dev/tty
  local mark
  for o in "$@"; do v="${o%% — *}"; mark=" "; in_list "$v" "$defs" && mark=x; printf '  %2d) [%s] %s\n' $i "$mark" "$o" >/dev/tty; i=$((i+1)); done
  printf '  numbers separated by space, "-" for none, Enter = marked ones: ' >/dev/tty; IFS= read -r a </dev/tty || true
  [ -z "$a" ] && { echo "$defs"; return; }
  [ "$a" = "-" ] && { echo ""; return; }
  for n in $a; do i=1; for o in "$@"; do [ "$i" = "$n" ] && sel="$sel ${o%% — *}"; i=$((i+1)); done; done
  echo $sel
}

# ---------------------------------------------------------------- copying (never clobber unless --force)
FORCE=0; CREATED=0; UPDATED=0; CONFLICTS=""; UPGRADE=0; RECORDED=""; KEPT=""; BASELINES=""   # BASELINES: "sha  rel" lines
sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else sha256sum "$1" | cut -d' ' -f1; fi; }
manifest_hash() { [ -f "$TARGET/.agent/kit.manifest" ] && awk -v p="$1" '$2 == p {print $1}' "$TARGET/.agent/kit.manifest" | head -n1; return 0; }
record() { RECORDED="$RECORDED
$1"; }
copy_file() { # copy_file <src> <dest> — never clobbers user edits; on upgrade refreshes files the user did not change
  local s="$1" d="$2" rel mh
  rel="${d#"$TARGET"/}"
  mkdir -p "$(dirname "$d")"
  if [ -e "$d" ] && [ $FORCE -eq 0 ]; then
    if cmp -s "$s" "$d"; then record "$rel"
    elif [ $UPGRADE -eq 1 ] && mh="$(manifest_hash "$rel")" && [ -n "$mh" ]; then
      if [ "$mh" = "$(sha "$d")" ]; then cp "$s" "$d"; UPDATED=$((UPDATED+1)); record "$rel"   # untouched by the user → refresh
      else
        KEPT="$KEPT
$rel"                                                                                          # edited by the user → keep, baseline stays
        [ "$(sha "$s")" = "$mh" ] || { cp "$s" "$d.kit-new"; CONFLICTS="$CONFLICTS $rel"; }      # .kit-new only if the kit changed it too
      fi
    else cp "$s" "$d.kit-new"; CONFLICTS="$CONFLICTS $rel"; fi
  elif [ $UPGRADE -eq 1 ] && mh="$(manifest_hash "$rel")" && [ -n "$mh" ]; then
    BASELINES="$BASELINES
$mh  $rel"   # installed before and deleted by the user (or skipped on purpose): respect it — and remember it for the next upgrade
    return 0
  else
    cp "$s" "$d"; CREATED=$((CREATED+1)); record "$rel"
  fi
  case "$s" in */scripts/*|*/hooks/*|*/.githooks/*|*.sh) chmod +x "$d" 2>/dev/null || true ;; esac
}
write_file() { # write_file <dest> <content-file>  (generated content, same no-clobber rule)
  copy_file "$2" "$1"
}
copy_tree() { # copy_tree <srcdir> <destdir>
  local src="$1" dst="$2" f
  [ -d "$src" ] || return 0
  while IFS= read -r -d '' f; do copy_file "$f" "$dst/${f#"$src"/}"; done < <(find "$src" -type f -print0)
}
append_block() { # append_block <src> <dest>  (once, marker ">>> agent-kit")
  local s="$1" d="$2"
  if [ -f "$d" ] && grep -q '>>> agent-kit' "$d"; then return; fi
  [ -f "$d" ] && [ -n "$(tail -c1 "$d")" ] && echo >> "$d"
  cat "$s" >> "$d"
}
append_lines_missing() { # append_lines_missing <src> <dest>  — each line once
  local l
  while IFS= read -r l; do [ -z "$l" ] && continue; grep -qxF "$l" "$2" 2>/dev/null || echo "$l" >> "$2"; done < "$1"
}
gi_needed() { # gi_needed <src> <dest .gitignore> — the patterns of <src> the existing rules do not already cover (asked to git itself,
  # so `**/.venv/` in the repo covers the kit's `.venv/`); a negation is kept only when its path is ignored at that point
  local tmp l probe
  tmp="$(mktemp -d)"
  if ! git -C "$tmp" init -q >/dev/null 2>&1; then grep -vE '^[[:space:]]*(#|$)' "$1" || true; rm -rf "$tmp"; return 0; fi
  if [ -f "$2" ]; then cp "$2" "$tmp/.gitignore"; else : > "$tmp/.gitignore"; fi
  while IFS= read -r l; do
    case "$l" in ''|'#'*) continue ;; esac
    probe="${l#!}"; probe="${probe#/}"; probe="${probe#\*\*/}"
    case "$probe" in */) probe="${probe%/}/x" ;; esac   # a folder pattern: probe a file inside it
    probe="$(printf '%s' "$probe" | sed -e 's/\[[^]]*\]/c/g' -e 's/[*?]/x/g')"
    if [ "${l#!}" != "$l" ]; then git -C "$tmp" check-ignore -q --no-index -- "$probe" 2>/dev/null || continue
    else ! git -C "$tmp" check-ignore -q --no-index -- "$probe" 2>/dev/null || continue; fi
    printf '%s\n' "$l"; printf '\n%s\n' "$l" >> "$tmp/.gitignore"
  done < "$1"
  rm -rf "$tmp"
}
append_gitignore() { # append_gitignore <src> <dest> [block] — only what the repo's .gitignore does not cover; block = inside ">>> agent-kit" markers
  local need
  if [ "${3:-}" = block ] && [ -f "$2" ] && grep -q '>>> agent-kit' "$2"; then return 0; fi
  need="$(gi_needed "$1" "$2")"
  [ -n "$need" ] || return 0
  [ -f "$2" ] && [ -n "$(tail -c1 "$2")" ] && echo >> "$2"
  if [ "${3:-}" = block ]; then printf '# >>> agent-kit\n%s\n# <<< agent-kit\n' "$need" >> "$2"; else printf '%s\n' "$need" >> "$2"; fi
}

merge_settings() {
  local ours="$CORE/.claude/settings.json" theirs="$TARGET/.claude/settings.json"
  if [ $UPGRADE -eq 1 ] && [ -f "$theirs" ] && [ "$(manifest_hash .claude/settings.json)" = "$(sha "$theirs")" ]; then
    copy_file "$ours" "$theirs"; return 0
  fi
  if [ -f "$theirs" ] && [ $FORCE -eq 0 ] && command -v jq >/dev/null 2>&1; then
    cmp -s "$ours" "$theirs" && { record .claude/settings.json; return 0; }
    cp "$theirs" "$theirs.bak-kit"
    jq -s '
      def uniq_cat(a;b): ((a // []) + (b // [])) | unique;
      .[0] as $t | .[1] as $o |
      $t * {
        permissions: { allow: uniq_cat($t.permissions.allow; $o.permissions.allow),
                       ask:   uniq_cat($t.permissions.ask;   $o.permissions.ask),
                       deny:  uniq_cat($t.permissions.deny;  $o.permissions.deny) },
        hooks: ( ($t.hooks // {}) as $th | ($o.hooks // {}) as $oh
                 | reduce (($th + $oh) | keys[]) as $k ({}; .[$k] = (($th[$k] // []) + ($oh[$k] // []) | unique)) )
      }' "$theirs" "$ours" > "$theirs.tmp" && mv "$theirs.tmp" "$theirs"
    say "merged hooks/permissions into existing .claude/settings.json (backup: settings.json.bak-kit)"
  else
    copy_file "$ours" "$theirs"
  fi
}

# ---------------------------------------------------------------- components
C_PATH=(); C_STACK=(); C_FW=()
add_component() { # add_component <path> <stack> <fw>
  local p="${1:-.}" s="$2" f="${3:-}"
  p="${p%/}"; [ -z "$p" ] && p="."
  [ -f "$(stack_yaml "$s")" ] || die "unknown stack '$s' (kit list)"
  if [ -n "$f" ] && [ -z "$(fw_dir "$s" "$f")" ]; then die "unknown framework '$f' for stack '$s' (available: $(fw_list "$s"))"; fi
  C_PATH+=("$p"); C_STACK+=("$s"); C_FW+=("$f")
}
parse_components_str() { # "path=stack+fw …"
  local tok p rest
  for tok in $1; do p="${tok%%=*}"; rest="${tok#*=}"; add_component "$p" "${rest%%+*}" "$(printf '%s' "$rest" | sed -n 's/^[^+]*+//p')"; done
}
parse_stack_flag() { # "stack[:path[:fw]],…"
  local IFS=, tok s p f
  for tok in $1; do
    s="$(printf '%s' "$tok" | cut -d: -f1)"; p="$(printf '%s' "$tok" | cut -s -d: -f2)"; f="$(printf '%s' "$tok" | cut -s -d: -f3)"
    [ "$s" = auto ] && { parse_components_str "$(detect_components "$TARGET")"; continue; }
    add_component "${p:-.}" "$s" "$f"
  done
}
components_str() { local i o=""; for i in "${!C_PATH[@]}"; do o="$o ${C_PATH[$i]}=${C_STACK[$i]}+${C_FW[$i]}"; done; echo $o; }
describe_components() { local i; for i in "${!C_PATH[@]}"; do printf '   - %-12s %s%s\n' "${C_PATH[$i]}" "${C_STACK[$i]}" "$( [ -n "${C_FW[$i]}" ] && echo " + ${C_FW[$i]}")" >&2; done; }
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'; }

# ---- adopting a repo that already has code (EXISTING=1): the repo is the reference, not the kit's defaults
EXISTING=0; REPO_SNAP=""
CORE_TOOLS=" uv pip pip3 npm pnpm yarn bun npx dbt mvn mvnw gradle gradlew go gofmt cargo dotnet composer php bundle make node python python3 bash sh test java kit-diagrams "
repo_snapshot() { # what the repo uses today, taken BEFORE the kit writes anything: file names + dependency / CI / hook files
  REPO_SNAP="$(mktemp)"
  local f man="$TARGET/.agent/kit.manifest"
  ( cd "$TARGET" && find . -maxdepth 4 \( -name .git -o -name node_modules -o -name .venv -o -name venv -o -name .agent -o -name .agents \
      -o -name dbt_packages -o -name target -o -name vendor \) -prune -o -type f -print 2>/dev/null ) | sed 's#^\./##' > "$REPO_SNAP.files"
  if [ -f "$man" ]; then   # a re-run: files the kit installed before do not count as "the repo uses it"
    awk '{print $2}' "$man" | grep -vxFf - "$REPO_SNAP.files" > "$REPO_SNAP.tmp" || true; mv "$REPO_SNAP.tmp" "$REPO_SNAP.files"
  fi
  { cat "$REPO_SNAP.files"
    while IFS= read -r f; do
      case "${f##*/}" in
        pyproject.toml|requirements*.txt|setup.cfg|tox.ini|noxfile.py|Pipfile|.pre-commit-config.yaml|.gitlab-ci.yml|Makefile|package.json|composer.json|*.csproj|Cargo.toml|go.mod|pom.xml|build.gradle*|lefthook.yml) cat "$TARGET/$f" 2>/dev/null || true ;;
      esac
      case "$f" in .github/workflows/*|.husky/*) cat "$TARGET/$f" 2>/dev/null || true ;; esac
    done < "$REPO_SNAP.files"; } > "$REPO_SNAP"
}
tool_used() { # tool_used <tool> — the repo mentions it (dependency, config file, CI, hook)
  local re="$1"
  case "$1" in lint-imports) re='import-linter|lint-imports|importlinter' ;; esac
  [ -n "$REPO_SNAP" ] && grep -qiE -- "(^|[^a-z0-9_-])($re)([^a-z0-9_-]|\$)" "$REPO_SNAP"
}
seg_tool() { # seg_tool "<command>" — the program a command really runs (wrappers such as `uv run`, `npx` stripped)
  local t; set -f; set -- $1; set +f
  case "${1:-}" in
    uv|poetry|pdm|hatch|pipenv|rye) if [ "${2:-}" = run ]; then shift 2
        while [ -n "${1:-}" ] && [ "${1#-}" != "$1" ]; do case "$1" in --project|--directory|--with|--group|--extra|--python) shift 2 ;; *) shift ;; esac; done; fi ;;
    npx) shift; while [ -n "${1:-}" ] && [ "${1#-}" != "$1" ]; do shift; done ;;
    pnpm) [ "${2:-}" = exec ] && shift 2 ;;
    python|python3) [ "${2:-}" = -m ] && shift 2 ;;
  esac
  t="${1:-}"; t="${t##*/}"; t="${t%%@*}"; printf '%s' "$t"
}
uv_project_with() { # uv_project_with <package> — a folder (relative to the repo) whose uv project depends on it, e.g. ingestion
  local f
  while IFS= read -r f; do
    [ -f "$(dirname "$f")/uv.lock" ] && grep -qiE "^[[:space:]]*\"$1([^a-z0-9_-]|\")" "$f" && { f="${f#"$TARGET"/}"; f="$(dirname "$f")"; printf '%s' "$f"; return 0; }
  done < <(find "$TARGET" -maxdepth 3 -name pyproject.toml -not -path '*/.venv/*' -not -path '*/node_modules/*' 2>/dev/null | sort)
  return 0
}
rel_from() { # rel_from <component path> <repo-relative path> — the second path as seen from inside the component
  [ "$1" = . ] && { printf '%s' "$2"; return; }
  local up; up="$(printf '%s' "$1" | sed 's#[^/][^/]*#..#g')"
  [ "$2" = . ] && printf '%s' "$up" || printf '%s/%s' "$up" "$2"
}
ci_pytest_flags() { # --ignore=… flags the repo's own CI passes to pytest (e.g. tests that call real APIs)
  local f man="$TARGET/.agent/kit.manifest"
  for f in "$TARGET/.gitlab-ci.yml" "$TARGET"/.github/workflows/*.yml "$TARGET"/.github/workflows/*.yaml; do
    [ -f "$f" ] || continue
    [ -f "$man" ] && awk '{print $2}' "$man" | grep -qxF "${f#"$TARGET"/}" && continue
    grep -E 'pytest' "$f" | grep -oE -- '--ignore[= ][^ "'"'"']+' || true
  done | sed 's/^--ignore /--ignore=/' | awk '!seen[$0]++' | tr '\n' ' ' | sed 's/ $//'
}
dbt_has_ci_target() { [ ! -f "$1/profiles.yml" ] || grep -qE '^[[:space:]]+ci:[[:space:]]*$' "$1/profiles.yml"; }
has_dbt_evaluator() { local p; for p in "$1/packages.yml" "$1/dependencies.yml"; do [ -f "$p" ] && { grep -q dbt_project_evaluator "$p"; return; }; done; return 0; }

# value of a step for one component; in an existing repo a gate whose tool the repo does not use is left empty
comp_value() { # comp_value <idx> <key>
  local v t
  v="$(comp_raw "$@")"
  if [ $EXISTING -eq 1 ] && [ -n "$v" ]; then
    t="$(seg_tool "$v")"
    case "$CORE_TOOLS" in *" $t "*) ;; *) tool_used "$t" || v="" ;; esac
  fi
  printf '%s' "$v"
}
comp_unused() { # tools of a component's gates the repo does not use (only meaningful when EXISTING=1)
  local i="$1" step v t out=""
  for step in $STEPS; do
    v="$(comp_raw "$i" "cmd_$step")"; [ -n "$v" ] || continue
    t="$(seg_tool "$v")"
    case "$CORE_TOOLS" in *" $t "*) continue ;; esac
    tool_used "$t" || case " $out " in *" $t "*) ;; *) out="$out $t" ;; esac
  done
  printf '%s' "${out# }"
}
# framework override > stack; then tool-specific adjustments
comp_raw() { # comp_raw <idx> <key>
  local i="$1" k="$2" s="${C_STACK[$1]}" f="${C_FW[$1]}" d v sy tool proj pf
  sy="$(stack_yaml "$s")"; v="$(yget "$sy" "$k")"
  if [ -n "$f" ]; then d="$(fw_dir "$s" "$f")"; yhas "$d/framework.yaml" "$k" && v="$(yget "$d/framework.yaml" "$k")"; fi
  [ -n "$v" ] || { echo ""; return; }
  local dir="$TARGET/${C_PATH[$i]}"
  case "$s" in
    java-maven)  [ -x "$dir/mvnw" ] || v="$(printf '%s' "$v" | sed 's#\./mvnw#mvn#g')" ;;
    java-gradle) [ -x "$dir/gradlew" ] || v="$(printf '%s' "$v" | sed 's#\./gradlew#gradle#g')" ;;
    node)
      if [ -f "$dir/pnpm-lock.yaml" ]; then
        v="$(printf '%s' "$v" | sed -e 's#npm ci#pnpm install --frozen-lockfile#' -e 's#npx --no-install#pnpm exec#g' -e 's#npm test --if-present#pnpm test#' \
             -e 's#npm run --if-present#pnpm run --if-present#g' -e 's#npm audit --audit-level=high --omit=dev#pnpm audit --audit-level high --prod#' -e 's#npm install -D#pnpm add -D#')"
      elif [ -f "$dir/yarn.lock" ]; then
        v="$(printf '%s' "$v" | sed -e 's#npm ci#yarn install --frozen-lockfile#' -e 's#npx --no-install#yarn#g' -e 's#npm test --if-present#yarn test#' \
             -e 's#npm run --if-present#yarn run#g' -e 's#npm audit --audit-level=high --omit=dev#yarn npm audit --severity high#' -e 's#npm install -D#yarn add -D#')"
      elif [ ! -f "$dir/package-lock.json" ]; then v="$(printf '%s' "$v" | sed 's#npm ci#npm install#')"; fi ;;
    python)
      if [ -f "$dir/uv.lock" ]; then
        v="$(printf '%s' "$v" | sed -E -e 's#^pip install -r requirements.txt$#uv sync#' -e 's#^pip install #uv add --dev #' -e 's#^(ruff|mypy|pytest|pip-audit|lint-imports)#uv run \1#')"
        # dev tools declared as [project.optional-dependencies] dev are only installed with --extra dev
        if [ "$v" = "uv sync" ] && awk '/^\[project\.optional-dependencies\]/{f=1;next} /^\[/{f=0} f && /^dev[[:space:]]*=/{x=1} END{exit !x}' "$dir/pyproject.toml" 2>/dev/null; then
          v="uv sync --extra dev"
        fi
      elif [ -f "$dir/pyproject.toml" ] && [ ! -f "$dir/requirements.txt" ]; then
        v="$(printf '%s' "$v" | sed 's#^pip install -r requirements.txt$#pip install -e ".[dev]"#')"
      fi
      # the flags the repo's CI gives pytest (e.g. --ignore=tests/live: tests that need real credentials)
      if [ $EXISTING -eq 1 ]; then case "$v" in *pytest*) pf="$(ci_pytest_flags)"; [ -z "$pf" ] || v="$(printf '%s' "$v" | sed "s#pytest -q#pytest -q $pf#")" ;; esac; fi ;;
    dbt)
      # dbt (or sqlfluff) installed in another component's uv project, e.g. ingestion/pyproject.toml lists dbt-core
      tool="${v%% *}"
      case "$tool" in dbt|sqlfluff)
        pf="$tool"; [ "$tool" = dbt ] && pf=dbt-core
        if ! grep -qsiE "(^|[^a-z0-9_-])$pf" "$dir/pyproject.toml" "$dir"/requirements*.txt && proj="$(uv_project_with "$pf")" && [ -n "$proj" ]; then
          v="uv run --project $(rel_from "${C_PATH[$i]}" "$proj") $v"
        fi ;;
      esac
      # `--target ci` only works when profiles.yml has that target (otherwise dbt would run against another, maybe a real warehouse)
      case "$v" in *"--target ci"*) dbt_has_ci_target "$dir" || v="" ;; esac
      # the dbt_project_evaluator gate only when the project installs that package
      if ! has_dbt_evaluator "$dir"; then
        case "$v" in *"--select package:dbt_project_evaluator"*) v="" ;; esac
        v="${v/ --exclude package:dbt_project_evaluator/}"
      fi ;;
  esac
  printf '%s' "$v"
}
build_commands() { # sets CMD_<step> (joined across components)
  local step i v p cur name
  for step in $STEPS; do
    printf -v "CMD_$step" '%s' ""
    for i in "${!C_PATH[@]}"; do
      v="$(comp_value "$i" "cmd_$step")"; [ -n "$v" ] || continue
      p="${C_PATH[$i]}"; [ "$p" != "." ] && v="(cd $p && $v)"
      name="CMD_$step"; cur="${!name}"
      if [ -n "$cur" ]; then printf -v "$name" '%s && %s' "$cur" "$v"; else printf -v "$name" '%s' "$v"; fi
    done
  done
}

comp_dockerfile() { # framework Dockerfile > stack Dockerfile
  local d=""; [ -n "${C_FW[$1]}" ] && d="$(fw_dir "${C_STACK[$1]}" "${C_FW[$1]}")"
  if [ -n "$d" ] && [ -f "$d/docker/Dockerfile" ]; then printf '%s' "$d/docker/Dockerfile"; else stack_asset "${C_STACK[$1]}" docker/Dockerfile; fi
}

# ---------------------------------------------------------------- install pieces
detect_provider() { # github | gitlab — the Git host this repo lives on (keep in sync with git_provider in core/.agent/scripts/lib.sh)
  local u; u="$(git -C "$TARGET" remote get-url origin 2>/dev/null || git -C "$TARGET" remote -v 2>/dev/null | awk 'NR==1{print $2}' || true)"
  case "$u" in *github*) echo github; return 0 ;; *gitlab*) echo gitlab; return 0 ;; esac
  if [ -f "$TARGET/.gitlab-ci.yml" ] || [ -d "$TARGET/.gitlab" ]; then echo gitlab; else echo github; fi
}
resolve_provider() { # PROVIDER: --provider > project.yaml git_provider > detected
  local cur=""
  [ -f "$TARGET/.agent/project.yaml" ] && cur="$(yget "$TARGET/.agent/project.yaml" git_provider)"
  [ "${PROVIDER:-auto}" != auto ] || PROVIDER="${cur:-$(detect_provider)}"
  case "$PROVIDER" in github|gitlab|none) ;; *) die "git_provider must be github, gitlab or none (got '$PROVIDER')" ;; esac
}
install_core() {
  local f rel
  while IFS= read -r -d '' f; do
    rel="${f#"$CORE"/}"
    case "$rel" in *.kit|.agent/project.yaml.tpl|.claude/settings.json) continue ;; esac
    case "$rel" in   # only the files of the Git host in use: .github/ for GitHub, .gitlab/ + the pipeline for GitLab
      .github/*) [ "$PROVIDER" = github ] || continue ;;
      .gitlab/*) [ "$PROVIDER" = gitlab ] || continue ;;
      .gitlab-ci.kit.yml) [ "$PROVIDER" = gitlab ] || continue
        # never touch a pipeline the project already owns: ours then goes to .gitlab-ci.kit.yml and is `include:`d by hand
        if [ -f "$TARGET/.gitlab-ci.yml" ] && [ -z "$(manifest_hash .gitlab-ci.yml)" ]; then
          copy_file "$f" "$TARGET/.gitlab-ci.kit.yml"
          NOTES="$NOTES
   - CI: your .gitlab-ci.yml was left alone. Add this at its top to run the kit's gates too:   include: [{ local: .gitlab-ci.kit.yml }]   (its jobs use the stages .pre and test — keep test in your stages:)"
        else copy_file "$f" "$TARGET/.gitlab-ci.yml"; fi
        continue ;;
    esac
    copy_file "$f" "$TARGET/$rel"
  done < <(find "$CORE" -type f -print0)
  merge_settings
  append_gitignore "$CORE/gitignore.kit" "$TARGET/.gitignore" block
  append_block "$CORE/gitattributes.kit" "$TARGET/.gitattributes"
  # an env template the repo keeps somewhere else (platform/.env.example, app.env.example…) is enough — no second one at the root
  if [ ! -f "$TARGET/.env.example" ] && [ -z "$(find "$TARGET" -maxdepth 3 \( -name .git -o -name node_modules -o -name .venv \) -prune -o \
       -type f \( -name '.env.example' -o -name '*.env.example' -o -name '.env.sample' -o -name '.env.template' \) -print 2>/dev/null | head -n1)" ]; then
    cp "$CORE/env.example.kit" "$TARGET/.env.example"
  fi
}

# A nested component (path != .) must not add a second copy of a tool config the repo already has in a parent folder: tools such as ruff
# use the NEAREST config only, so the kit's file would silently replace the project's. true = skip (and say so).
config_above() { # config_above <component path> <relative file>
  local p="$1" rel="$2" d
  [ "$p" != "." ] || return 1
  case "$rel" in ruff.toml|.ruff.toml|.editorconfig|.sqlfluff|.prettierrc|.prettierrc.json) ;; *) return 1 ;; esac
  d="$TARGET/$p"
  while [ "$d" != "$TARGET" ] && [ "$d" != "/" ]; do
    d="$(dirname "$d")"
    if [ -f "$d/$rel" ] || { case "$rel" in ruff.toml|.ruff.toml) [ -f "$d/ruff.toml" ] || [ -f "$d/.ruff.toml" ] || grep -qs '^\[tool\.ruff' "$d/pyproject.toml" ;; *) false ;; esac; }; then
      local where="${d#"$TARGET"}"; where="${where#/}"
      note "[$p] $rel: the repo already has one in ${where:-the repo root} — not adding a second that would replace it for $p/"
      return 0
    fi
  done
  return 1
}
# Existing repo: no config for a tool whose gate is off (mypy.ini without mypy, .sqlfluff without sqlfluff). The kit's version goes into
# the manifest as a baseline, so `kit upgrade` treats it like a file the user deleted and does not bring it back.
unused_config() { # unused_config <src> <dest> "<unused tools>" — true = skip
  local t b="${1##*/}"
  [ ! -e "$2" ] || return 1
  for t in $3; do
    case "$b" in *"$t"*)
      BASELINES="$BASELINES
$(sha "$1")  ${2#"$TARGET"/}"; return 0 ;;
    esac
  done
  return 1
}
install_component() { # install_component <idx>
  local i="$1" p="${C_PATH[$1]}" s="${C_STACK[$1]}" f="${C_FW[$1]}" fd="" src rel files dest tmp globs g paths="" note own
  dest="$TARGET"; [ "$p" != "." ] && dest="$TARGET/$p"
  mkdir -p "$dest"
  [ -n "$f" ] && fd="$(fw_dir "$s" "$f")"
  local unused=""; [ $EXISTING -eq 1 ] && unused="$(comp_unused "$i")"
  # 1. tool configs: stack files, framework files win on the same path
  files="$(stack_asset "$s" files)"
  if [ -n "$files" ]; then
    while IFS= read -r -d '' src; do
      rel="${src#"$files"/}"
      [ -n "$fd" ] && in_list "$rel" "$(yget "$fd/framework.yaml" exclude_files)" && continue
      config_above "$p" "$rel" && continue
      unused_config "$src" "$dest/$rel" "$unused" && continue
      if [ -n "$fd" ] && [ -f "$fd/files/$rel" ]; then copy_file "$fd/files/$rel" "$dest/$rel"; else copy_file "$src" "$dest/$rel"; fi
    done < <(find "$files" -type f -print0)
  fi
  if [ -n "$fd" ] && [ -d "$fd/files" ]; then
    while IFS= read -r -d '' src; do
      rel="${src#"$fd/files"/}"; [ -n "$files" ] && [ -f "$files/$rel" ] && continue
      config_above "$p" "$rel" && continue
      unused_config "$src" "$dest/$rel" "$unused" && continue
      copy_file "$src" "$dest/$rel"
    done < <(find "$fd/files" -type f -print0)
  fi
  # 1b. ignore build/dependency output of this stack (patterns match at any depth)
  src="$(stack_asset "$s" gitignore.add)"; [ -n "$src" ] && append_gitignore "$src" "$TARGET/.gitignore"
  [ -n "$fd" ] && [ -f "$fd/gitignore.add" ] && append_gitignore "$fd/gitignore.add" "$TARGET/.gitignore"
  # 2. rules + snippets
  src="$(stack_asset "$s" rules.md)"; [ -n "$src" ] && copy_file "$src" "$TARGET/.agent/rules/stack/$s.md"
  [ -n "$fd" ] && [ -f "$fd/rules.md" ] && copy_file "$fd/rules.md" "$TARGET/.agent/rules/stack/$f.md"
  src="$(stack_asset "$s" snippets)"; [ -n "$src" ] && copy_tree "$src" "$TARGET/.agent/stack/$s/snippets"
  [ -n "$fd" ] && [ -d "$fd/snippets" ] && copy_tree "$fd/snippets" "$TARGET/.agent/stack/$s/snippets"
  # architecture skeletons (kit-new module): the stack's own in skeletons/, each framework's in skeletons/<framework>/,
  # so two components of one stack (node+nestjs backend, node+react frontend, plain node) never overwrite each other
  # Upgrade from < 0.11 (skeletons/<framework>/ does not exist yet): the framework's skeleton used to live in the shared folder.
  # If the shared file WAS this framework's (its manifest baseline is one of the framework's shipped versions, listed in
  # stacks/skeleton-hashes.txt) and the user edited it, carry the edit into skeletons/<framework>/ (kit's file → .kit-new) and give
  # the shared folder back to the stack's own skeleton. A shared file that came from the stack or another framework is not moved.
  if [ -n "$fd" ] && [ -d "$fd/skeletons" ]; then
    local sk nm shd sbd mh stk fkey
    fkey="$(printf '%s' "${fd#"$STACKS"/}" | sed 's#/frameworks/#/#')"   # owning stack/framework (java-gradle reuses java-maven/spring)
    for sk in "$fd/skeletons"/*; do
      [ -f "$sk" ] || continue
      nm="$(basename "$sk")"; shd="$TARGET/.agent/stack/$s/skeletons/$nm"; sbd="$TARGET/.agent/stack/$s/skeletons/$f/$nm"
      stk="$(stack_asset "$s" skeletons)"; [ -n "$stk" ] && stk="$stk/$nm"
      mh=""; [ $UPGRADE -eq 1 ] && [ ! -e "$sbd" ] && [ -f "$shd" ] && mh="$(manifest_hash "${shd#"$TARGET"/}")"
      if [ -n "$mh" ] && [ "$mh" != "$(sha "$shd")" ] && { [ "$mh" = "$(sha "$sk")" ] || grep -qx "$mh  $fkey/$nm" "${KIT_SKELETON_HASHES:-$KIT_SRC/stacks/skeleton-hashes.txt}" 2>/dev/null; }; then
        mkdir -p "$(dirname "$sbd")"; cp "$shd" "$sbd"; cp "$sk" "$sbd.kit-new"
        BASELINES="$BASELINES
$(sha "$sk")  ${sbd#"$TARGET"/}"; CONFLICTS="$CONFLICTS ${sbd#"$TARGET"/}"   # baseline = kit's file, so later upgrades see the edit
        if [ -n "$stk" ] && [ -f "$stk" ]; then cp "$stk" "$shd"; else rm -f "$shd"; fi   # shared slot back to the stack (recorded below)
        # another component of this stack may already have kept the edited shared file as a conflict: that is resolved now
        rm -f "$shd.kit-new"; KEPT="$(printf '%s\n' "$KEPT" | grep -vxF "${shd#"$TARGET"/}" || true)"
        CONFLICTS="$(printf '%s' " $CONFLICTS " | sed "s# ${shd#"$TARGET"/} # #g")"
        note "kept your customised skeleton: ${shd#"$TARGET"/} → ${sbd#"$TARGET"/} (kit's version: $nm.kit-new)"
      else
        if [ -n "$mh" ] && [ "$mh" != "$(sha "$shd")" ] && ! { [ -n "$stk" ] && [ -f "$stk" ] && cmp -s "$stk" "$shd"; }; then
          note "your edited ${shd#"$TARGET"/} is not $f's skeleton — $f now uses ${sbd#"$TARGET"/}; compare and port your edits if they were meant for $f"
        fi
        copy_file "$sk" "$sbd"
      fi
    done
  fi
  src="$(stack_asset "$s" skeletons)"
  if [ -n "$src" ]; then
    for rel in "$src"/*; do
      [ -f "$rel" ] || continue
      copy_file "$rel" "$TARGET/.agent/stack/$s/skeletons/$(basename "$rel")"
    done
  fi
  # 3. Claude Code path-scoped rule pointer
  globs="$(yget "$(stack_yaml "$s")" globs)"
  if [ -n "$globs" ]; then
    tmp="$(mktemp)"
    set -f
    { echo "---"; echo "paths:"
      for g in $globs; do if [ "$p" = "." ]; then echo "  - \"$g\""; else echo "  - \"$p/$g\""; fi; done
      echo "---"
      if [ "$p" = "." ]; then echo "# ${s}${f:+ + $f} code"; else echo "# ${s}${f:+ + $f} code in \`$p/\`"; fi
      echo "Before editing these files read and follow \`.agent/rules/stack/$s.md\`${f:+ and \`.agent/rules/stack/$f.md\`}."
      echo "Tool configs in $( [ "$p" = . ] && echo "the repo root" || echo "\`$p/\`") are law (never relax them). Before a checkpoint run \`.agent/scripts/kit-run format_check lint typecheck arch\`."
    } > "$tmp"
    set +f
    rel="stack-$s"; [ "$p" != "." ] && rel="$rel-$(slug "$p")"
    write_file "$TARGET/.claude/rules/$rel.md" "$tmp"
    # Antigravity: same pointer as a glob-triggered workspace rule
    local gl=""; set -f
    for g in $globs; do if [ "$p" = "." ]; then gl="${gl:+$gl, }$g"; else gl="${gl:+$gl, }$p/$g"; fi; done; set +f
    { echo "---"; echo "trigger: glob"; echo "description: ${s}${f:+ + $f} coding rules (agent-kit)"; echo "globs: $gl"; echo "---"
      sed '1,/^---$/d' "$tmp"; } > "$tmp.ag"
    write_file "$TARGET/.agents/rules/$rel.md" "$tmp.ag"; rm -f "$tmp" "$tmp.ag"
  fi
  # 4. Dockerfile
  if has_module devops; then
    src="$(comp_dockerfile "$i")"
    if [ -n "$src" ] && [ ! -e "$dest/Dockerfile" ] && own="$(find "$dest" -maxdepth 3 -iname 'Dockerfile*' -not -path '*/node_modules/*' -not -path '*/.venv/*' 2>/dev/null | head -n1)" && [ -n "$own" ]; then
      note "[$p] already has ${own#"$TARGET"/} — the kit's generic Dockerfile is not added"; src=""
    fi
    [ -z "$src" ] || copy_file "$src" "$dest/Dockerfile"
  fi
  note="$(yget "$(stack_yaml "$s")" post_note)"; [ -n "$note" ] && NOTES="$NOTES
   - [$p · $s] $note"
  return 0
}

MODS=""; SERVICES=""; NOTES=""; PROVIDER=auto; FLOW=auto; HOOKS=auto
has_module() { case " $MODS " in *" $1 "*) return 0 ;; esac; return 1; }
norm_mods() { echo $* | tr ' ' '\n' | sed 's/^docker$/devops/' | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//'; }

install_module_files() { # install_module_files <module>
  local m="$1" md="$MODULES/$1"
  [ -d "$md" ] || die "unknown module '$m' (kit list)"
  copy_tree "$md/files" "$TARGET"
  [ -f "$md/gitignore.add" ] && append_gitignore "$md/gitignore.add" "$TARGET/.gitignore"
  if [ "$m" = devops ]; then copy_tree "$md/catalog" "$TARGET/.agent/docker/catalog"; fi
  return 0
}
apply_project_add() { # put module cmd_* lines into project.yaml (fill empty keys, insert missing ones after cmd_audit, in order)
  local m l k cfg="$TARGET/.agent/project.yaml" add
  [ -f "$cfg" ] || return 0
  add="$(mktemp)"
  for m in $MODS; do
    [ -f "$MODULES/$m/project.add" ] || continue
    while IFS= read -r l; do
      k="${l%%:*}"; [ -z "$k" ] && continue
      case "$k" in cmd_up|cmd_down|cmd_logs) [ -z "$(existing_compose)" ] || [ -f "$TARGET/compose.yaml" ] || continue ;; esac   # the repo has its own compose: leave these to it
      if grep -q "^$k:[[:space:]]*$" "$cfg"; then   # literal replacement: the line may contain # & / \ (comments, URLs)
        K="$k" L="$l" awk 'BEGIN { k = ENVIRON["K"] ":"; n = length(k); l = ENVIRON["L"] }
          { line = $0; cr = ""; if (sub(/\r$/, "", line)) cr = "\r"
            if (substr(line, 1, n) == k && substr(line, n + 1) ~ /^[ \t]*$/) print l cr; else print }' "$cfg" > "$cfg.tmp" \
          && mv "$cfg.tmp" "$cfg"   # awk = literal match (no regex/escape surprises), keeps a CRLF ending
      elif ! grep -q "^$k:" "$cfg"; then echo "$l" >> "$add"; fi
    done < "$MODULES/$m/project.add"
  done
  if [ -s "$add" ]; then
    if grep -q '^cmd_audit:' "$cfg"; then
      awk -v af="$add" '{print} /^cmd_audit:/ && !done {while((getline x < af)>0) print x; done=1}' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
    else cat "$add" >> "$cfg"; fi
  fi
  rm -f "$add"
}

existing_compose() { # prints the first compose file the repo already has, else nothing. By CONTENT (a top-level `services:`), not by name:
  local f                # real repos call them platform/compose/core.yml, spark.yml, … not compose.yaml
  while IFS= read -r f; do
    if grep -q '^services:' "$f" 2>/dev/null; then printf '%s\n' "$f"; return 0; fi
  done < <(find "$TARGET" -maxdepth 4 \( -name '*.yml' -o -name '*.yaml' \) -size -400k -not -name '.gitlab-ci*' \
             -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/.agent/*' -not -path '*/.venv/*' -not -path '*/dbt_packages/*' \
             -not -path '*/target/*' -not -path '*/.github/*' -not -path '*/.gitlab/*' 2>/dev/null)
  return 0
}
generate_compose() {
  local out="$TARGET/compose.yaml" tmp i p s port host svc used="" deps="" sv vols="" v envtmp e ex
  [ -f "$out" ] && [ $FORCE -eq 0 ] && { note "compose.yaml exists — kept (add services with the kit-docker playbook; catalog in .agent/docker/catalog)"; return 0; }
  ex="$(existing_compose)"
  if [ -n "$ex" ] && [ $FORCE -eq 0 ]; then
    note "the repo already has ${ex#"$TARGET"/} — not generating a second compose.yaml; cmd_up / cmd_down / cmd_logs stay empty until you set your own"; return 0
  fi
  for sv in $SERVICES; do
    [ -f "$MODULES/devops/catalog/$sv.yml" ] || die "unknown docker service '$sv' (kit list)"
    if grep -q 'healthcheck:' "$MODULES/devops/catalog/$sv.yml" && ! grep -q 'profiles:' "$MODULES/devops/catalog/$sv.yml"; then deps="$deps $sv"; fi
    v="$(svc_meta "$sv" volumes)"; [ -n "$v" ] && vols="$vols $v"
  done
  tmp="$(mktemp)"
  {
    echo "# Local development environment — generated by agent-kit. Maintain with the kit-docker playbook."
    echo "# Start: .agent/scripts/kit-run up · Stop: kit-run down · Logs: kit-run logs · Observability: docker compose --profile obs up -d"
    echo "name: $(slug "$PROJECT_NAME")"
    echo "services:"
    for i in "${!C_PATH[@]}"; do
      p="${C_PATH[$i]}"; s="${C_STACK[$i]}"
      [ -n "$(comp_dockerfile "$i")" ] || continue
      if [ "$p" = "." ]; then svc=app; else svc="$(slug "$(basename "$p")")"; fi
      port="$(comp_value "$i" app_port)"; port="${port:-8080}"; host="$port"
      while in_list "$host" "$used"; do host=$((host+1)); done; used="$used $host"
      echo "  $svc:"
      echo "    build: ./${p#./}" | sed 's#\./\.$#.#; s#build: \./\.#build: .#'
      echo "    env_file:"
      echo "      - path: .env"
      echo "        required: false"
      echo "    ports: [\"\${$(printf '%s' "$svc" | tr '[:lower:]-' '[:upper:]_')_PORT:-$host}:$port\"]"
      if [ -n "$deps" ] && [ "$(comp_value "$i" no_backing_services)" != true ]; then
        echo "    depends_on:"
        for sv in $deps; do echo "      $sv: { condition: service_healthy }"; done
      fi
    done
    for sv in $SERVICES; do grep -v '^#' "$MODULES/devops/catalog/$sv.yml"; done
    if [ -n "$vols" ]; then echo "volumes:"; for v in $vols; do echo "  $v:"; done; fi
  } > "$tmp"
  if grep -q '^  [a-z]' "$tmp"; then copy_file "$tmp" "$out"; fi
  rm -f "$tmp"
  # env names → .env.example
  envtmp="$(mktemp)"
  for sv in $SERVICES; do for e in $(svc_meta "$sv" env); do printf '# %s\n' "$e" >> "$envtmp"; done; done
  if [ -s "$envtmp" ]; then
    grep -q '>>> agent-kit services' "$TARGET/.env.example" 2>/dev/null || {
      { echo; echo "# >>> agent-kit services (local docker defaults; real values only in .env)"; cat "$envtmp"; echo "# <<< agent-kit services"; } >> "$TARGET/.env.example"; }
  fi
  rm -f "$envtmp"
}

render_module_placeholders() { # values only known at install time
  local f="$TARGET/openspec/config.yaml" language
  case "$LANG_DOCS" in vi) language=Vietnamese ;; en) language=English ;; *) language="$LANG_DOCS" ;; esac
  [ -f "$f" ] && grep -q '{{DOCS_LANGUAGE}}' "$f" && { sed -i.bak "s/{{DOCS_LANGUAGE}}/$language/" "$f"; rm -f "$f.bak"; }
  return 0
}

generate_cd() { # .github/workflows/cd.yml for components that have a Dockerfile (module devops)
  local out="$TARGET/.github/workflows/cd.yml" tmp lines="" i p n
  [ -f "$out" ] && return 0
  for i in "${!C_PATH[@]}"; do
    [ -n "$(comp_dockerfile "$i")" ] || continue
    p="${C_PATH[$i]}"; if [ "$p" = "." ]; then n=app; else n="$(slug "$(basename "$p")")"; fi
    lines="$lines          - { name: $n, context: ./${p#./} }
"
  done
  [ -n "$lines" ] || return 0
  local lf; lf="$(mktemp)"; printf '%s' "$lines" | sed 's#context: \./\.#context: .#' > "$lf"
  tmp="$(mktemp)"
  awk -v lf="$lf" '/# @@IMAGES@@/ { while ((getline x < lf) > 0) print x; next } { print }' "$MODULES/devops/cd.yml.tpl" > "$tmp"
  copy_file "$tmp" "$out"; rm -f "$tmp" "$lf"
}

generate_dependabot() { # .github/dependabot.yml from the components (weekly, minor+patch grouped)
  local out="$TARGET/.github/dependabot.yml" tmp i p s eco dir
  [ -f "$out" ] && return 0
  tmp="$(mktemp)"
  { echo "# Generated by agent-kit: dependency update PRs (security updates are separate and immediate when enabled in GitHub)."
    echo "version: 2"; echo "updates:"
    for i in "${!C_PATH[@]}"; do
      p="${C_PATH[$i]}"; s="${C_STACK[$i]}"
      case "$s" in php) eco=composer ;; java-maven) eco=maven ;; java-gradle) eco=gradle ;; node) eco=npm ;; python|dbt) eco=pip ;;
                   go) eco=gomod ;; rust) eco=cargo ;; dotnet) eco=nuget ;; *) eco="" ;; esac
      [ -n "$eco" ] || continue
      dir="/"; [ "$p" != "." ] && dir="/$p"
      echo "  - package-ecosystem: $eco"; echo "    directory: \"$dir\""; echo "    schedule: { interval: weekly }"
      echo "    open-pull-requests-limit: 5"
      echo "    commit-message: { prefix: \"build\", include: scope }"
      echo "    groups: { minor-and-patch: { update-types: [minor, patch] } }"
      if has_module devops && [ -n "$(comp_dockerfile "$i")" ]; then
        echo "  - package-ecosystem: docker"; echo "    directory: \"$dir\""; echo "    schedule: { interval: weekly }"
        echo "    commit-message: { prefix: \"build\" }"
      fi
    done
    echo "  - package-ecosystem: github-actions"; echo "    directory: \"/\""; echo "    schedule: { interval: weekly }"
    echo "    commit-message: { prefix: \"ci\" }"
    echo "    groups: { actions: { patterns: [\"*\"] } }"
  } > "$tmp"
  copy_file "$tmp" "$out"; rm -f "$tmp"
}

wire_harnesses() { # one source of truth (.agents/skills + AGENTS.md) exposed to every harness
  local d n
  # Claude Code reads .claude/skills → symlink each canonical skill (Codex, Gemini CLI, Antigravity, dsh read .agents/skills)
  mkdir -p "$TARGET/.claude/skills"
  for d in "$TARGET"/.agents/skills/*/; do
    [ -f "$d/SKILL.md" ] || continue; n="$(basename "$d")"
    [ -e "$TARGET/.claude/skills/$n" ] || [ -L "$TARGET/.claude/skills/$n" ] || ln -s "../../.agents/skills/$n" "$TARGET/.claude/skills/$n"
  done
  # Gemini CLI: load AGENTS.md as context (GEMINI.md still honoured)
  local gs="$TARGET/.gemini/settings.json"; mkdir -p "$TARGET/.gemini"
  if [ -f "$gs" ] && command -v jq >/dev/null 2>&1; then
    jq '.context.fileName = ((((.context.fileName // []) | if type == "string" then [.] else . end) + ["AGENTS.md","GEMINI.md"]) | unique)' "$gs" > "$gs.tmp"
    if [ "$(jq -S . "$gs")" = "$(jq -S . "$gs.tmp")" ]; then rm -f "$gs.tmp"; else mv "$gs.tmp" "$gs"; fi   # only when it really changes: an upgrade must not reformat your file
  elif [ ! -f "$gs" ]; then
    printf '{\n  "context": { "fileName": ["AGENTS.md", "GEMINI.md"] }\n}\n' > "$gs"
  fi
  return 0
}

render_playbooks() { # fill AGENTS.md §6 from installed skills
  local list f n d af
  list="$(mktemp)"
  for f in "$TARGET"/.agents/skills/*/SKILL.md; do
    [ -f "$f" ] || continue
    n="$(sed -n 's/^name:[[:space:]]*//p' "$f" | head -n1)"
    d="$(sed -n 's/^description:[[:space:]]*//p' "$f" | head -n1 | sed -E 's/\. .*//' | cut -c1-120)"
    echo "- \`$n\` — $d" >> "$list"
  done
  for af in "$TARGET/AGENTS.md" "$TARGET/AGENTS.md.kit-new"; do
    [ -f "$af" ] && grep -q 'kit:playbooks:start' "$af" || continue
    awk -v lf="$list" '
      /kit:playbooks:start/ {print; while((getline l < lf)>0) print l; skip=1; next}
      /kit:playbooks:end/ {skip=0}
      !skip {print}' "$af" > "$af.tmp" && mv "$af.tmp" "$af"
  done
  rm -f "$list"
}

write_manifest() { # sha256 of every kit-managed file as it is now (after rendering) — basis for kit upgrade
  local out="$TARGET/.agent/kit.manifest" rel
  { echo "# agent-kit manifest: sha256 of files written by kit $VERSION — used by 'kit upgrade' to tell your edits from kit files"
    { printf '%s\n' "$RECORDED" | awk 'NF && !seen[$0]++' | while IFS= read -r rel; do
        [ -f "$TARGET/$rel" ] && printf '%s  %s\n' "$(sha "$TARGET/$rel")" "$rel"
      done
      # files the user edited keep the kit's original hash, so later upgrades still recognise the edit
      printf '%s\n' "$KEPT" | awk 'NF && !seen[$0]++' | while IFS= read -r rel; do
        printf '%s  %s\n' "$(manifest_hash "$rel")" "$rel"
      done
      printf '%s\n' "$BASELINES" | awk 'NF'; } | sort -k2 -u; } > "$out.tmp" && mv "$out.tmp" "$out"
}

sync_project_keys() { # add keys that newer kits introduced; never change values the project already has
  local cfg="$TARGET/.agent/project.yaml" step name k line added=""
  for step in $STEPS; do
    grep -q "^cmd_$step:" "$cfg" && continue
    name="CMD_$step"; printf 'cmd_%s: %s\n' "$step" "${!name}" >> "$cfg"; added="$added cmd_$step"
  done
  while IFS= read -r line; do
    k="$(printf '%s' "$line" | sed -n 's/^\([a-z_][a-z_0-9]*\):.*/\1/p')"; [ -n "$k" ] || continue
    case "$line" in *'{{'*) continue ;; esac
    grep -q "^$k:" "$cfg" || { echo "$line" >> "$cfg"; added="$added $k"; }
  done < "$CORE/.agent/project.yaml.tpl"
  [ -z "$added" ] || say "project.yaml: added new keys:$added"
}

write_project_yaml() {
  local cfg="$TARGET/.agent/project.yaml" tmp step name
  if [ -f "$cfg" ] && [ $FORCE -eq 0 ]; then
    note ".agent/project.yaml exists — kept. Commands for the selection were written to .agent/project.yaml.kit-new"
    cfg="$cfg.kit-new"
  fi
  tmp="$(mktemp)"
  for step in $STEPS; do name="CMD_$step"; printf 'cmd_%s: %s\n' "$step" "${!name}" >> "$tmp"; done
  awk -v cf="$tmp" '/\{\{COMMANDS\}\}/{while((getline l < cf)>0) print l; next} {print}' "$CORE/.agent/project.yaml.tpl" \
    | sed -e "s|{{NAME}}|$PROJECT_NAME|" -e "s|{{DESCRIPTION}}|TODO|" -e "s|{{KIT_VERSION}}|$VERSION|" \
          -e "s|{{STACK}}|${C_STACK[0]}|" -e "s|{{COMPONENTS}}|$(components_str)|" -e "s|{{MODULES}}|$MODS|" \
          -e "s|^docs_language: vi|docs_language: $LANG_DOCS|" -e "s|^git_provider:[[:space:]]*#|git_provider: $PROVIDER   #|" > "$cfg"
  rm -f "$tmp"; CREATED=$((CREATED+1))
  [ "${cfg%.kit-new}" = "$cfg" ] || return 0
  # keep a lock with the selection (for kit add / upgrades)
  { echo "kit_version: $VERSION"; echo "installed: $(date +%Y-%m-%d)"; echo "components: $(components_str)"
    echo "modules: $MODS"; echo "services: $SERVICES"; } > "$TARGET/.agent/kit.lock"
}

insert_ci_setup() {
  local ci f s seen="" tmp
  tmp="$(mktemp)"
  for s in "${C_STACK[@]}"; do
    case " $seen " in *" $s "*) continue ;; esac; seen="$seen $s"
    f="$STACKS/$s/ci.yml"; [ -f "$f" ] && cat "$f" >> "$tmp"
  done
  for ci in "$TARGET/.github/workflows/ci.yml" "$TARGET/.github/workflows/ci.yml.kit-new"; do
    [ -f "$ci" ] && grep -q '@@SETUP@@' "$ci" || continue
    awk -v sf="$tmp" '/# @@SETUP@@/{while((getline l < sf)>0) print l; next} {print}' "$ci" > "$ci.tmp" && mv "$ci.tmp" "$ci"
  done
  rm -f "$tmp"
  # GitLab: the primary stack's image + every stack's setup commands (stacks/<s>/ci.gitlab, one command per line)
  local img gl l; gl="$(mktemp)"; seen=""
  img="$(yget "$(stack_yaml "${C_STACK[0]}")" ci_image)"; img="${img:-debian:bookworm}"
  for s in "${C_STACK[@]}"; do
    case " $seen " in *" $s "*) continue ;; esac; seen="$seen $s"
    [ -f "$STACKS/$s/ci.gitlab" ] || continue
    while IFS= read -r l; do [ -z "$l" ] || printf '    - %s\n' "$l" >> "$gl"; done < "$STACKS/$s/ci.gitlab"
  done
  for ci in "$TARGET/.gitlab-ci.yml" "$TARGET/.gitlab-ci.yml.kit-new" "$TARGET/.gitlab-ci.kit.yml" "$TARGET/.gitlab-ci.kit.yml.kit-new"; do
    [ -f "$ci" ] && grep -q '@@GL_' "$ci" || continue   # a pipeline of your own has no placeholders and is never touched
    awk -v img="$img" -v sf="$gl" '{ sub(/@@GL_IMAGE@@/, img) } /# @@GL_SETUP@@/ { while ((getline l < sf) > 0) print l; next } { print }' "$ci" > "$ci.tmp" && mv "$ci.tmp" "$ci"
  done
  rm -f "$gl"
}

note_existing_gaps() { # existing repo: say which gates stayed empty and why, so kit-onboard (or a human) can decide
  local i p u d
  for i in "${!C_PATH[@]}"; do
    p="${C_PATH[$i]}"; d="$TARGET/$p"
    u="$(comp_unused "$i")"
    [ -z "$u" ] || NOTES="$NOTES
   - [$p] this repo does not use: $u — their gates stay empty (no config added). To adopt one: add it to the repo, then set its cmd_* in .agent/project.yaml"
    if [ "${C_STACK[$i]}" = dbt ]; then
      dbt_has_ci_target "$d" || NOTES="$NOTES
   - [$p · dbt] profiles.yml has no 'ci' target — the dbt gates (parse/build/docs) stay empty instead of running against another target. Add a ci target (.agent/stack/dbt/snippets/profiles.example.yml) and set them"
      has_dbt_evaluator "$d" || NOTES="$NOTES
   - [$p · dbt] dbt_project_evaluator is not in packages.yml — cmd_arch stays empty (add the package to turn the layer checks on)"
    fi
  done
  return 0
}
run_dev_deps() {
  local i p s cmd add dir tool
  if [ $EXISTING -eq 1 ]; then   # adding the kit's dev tools would change the project's own dependency files
    say "existing repo: dev dependencies are not changed — kit-run install uses the project's own (cmd_install)"; return 0
  fi
  for i in "${!C_PATH[@]}"; do
    p="${C_PATH[$i]}"; s="${C_STACK[$i]}"; dir="$TARGET/$p"
    cmd="$(comp_value "$i" dev_deps)"; add="$(comp_value "$i" dev_deps_add)"
    [ -n "$add" ] && cmd="${cmd:+$cmd && }$add"
    [ -n "$cmd" ] || continue
    tool="${cmd%% *}"
    if ! command -v "$tool" >/dev/null 2>&1; then note "[$p] '$tool' not installed — run later: (cd $p && $cmd)"; continue; fi
    if [ "$s" = python ] && [ "$tool" = pip ] && [ -z "${VIRTUAL_ENV:-}" ]; then note "[$p] no virtualenv active — run inside your venv: $cmd"; continue; fi
    if [ "$DEPS" = ask ]; then ui_confirm "[$p] install dev tools: $cmd" y || { NOTES="$NOTES
   - [$p] dev tools skipped: $cmd"; continue; }; fi
    say "[$p] $cmd"
    (cd "$dir" && bash -c "$cmd") || note "[$p] dev dependency install failed — rerun: (cd $p && $cmd)"
  done
}

run_tools() { # report the tools this selection needs; install only missing ones (asks, or --yes)
  local kt="$TARGET/.agent/scripts/kit-tools"
  [ -x "$kt" ] || return 0
  printf '\n' >&2; say "tools needed by this project:"
  (cd "$TARGET" && "$kt" status >&2) || true
  case "$TOOLS" in
    yes) (cd "$TARGET" && "$kt" install --yes >&2) || true ;;
    ask) if ui_confirm "Install the MISSING tools now (installed ones are kept as they are)?" y; then (cd "$TARGET" && "$kt" install >&2) || true; fi ;;
    *)   note "install missing tools later: kit tools $TARGET install" ;;
  esac
  return 0
}

run_module_setup() {
  local m desc
  for m in $MODS; do
    [ -x "$MODULES/$m/setup.sh" ] || continue
    desc="$(yget "$MODULES/$m/module.yaml" setup_desc)"
    if [ "$SETUP" = ask ]; then ui_confirm "module $m: $desc — run now?" y || { NOTES="$NOTES
   - module $m setup skipped: $desc"; continue; }; fi
    say "module $m: $desc"
    (cd "$TARGET" && KIT_YES=$( [ "${TOOLS:-no}" = yes ] && echo 1 || echo 0 ) KIT_NO_INSTALL=$( [ "${TOOLS:-no}" = no ] && echo 1 || echo 0 ) "$MODULES/$m/setup.sh") || note "module $m setup failed — rerun later"
  done
}

# ---- git hooks: the kit owns them (core.hooksPath), or a manager the project already uses (Husky, lefthook, …) calls the kit
KIT_HOOK_NAMES="pre-commit commit-msg pre-push"
hook_manager() { # husky | lefthook | pre-commit | other — a hook setup the project already has; empty = none
  local hp f; hp="$(git -C "$TARGET" config --get core.hooksPath 2>/dev/null || true)"
  if [ -d "$TARGET/.husky" ] || grep -qs '"husky"' "$TARGET/package.json"; then echo husky; return 0; fi
  for f in "$TARGET"/lefthook.* "$TARGET"/.lefthook.*; do [ ! -e "$f" ] || { echo lefthook; return 0; }; done
  if [ -f "$TARGET/.pre-commit-config.yaml" ]; then echo pre-commit; return 0; fi
  if [ -n "$hp" ] && [ "$hp" != .githooks ]; then echo other; return 0; fi
  local hd; hd="$(git -C "$TARGET" rev-parse --git-path hooks 2>/dev/null || true)"   # hand-written hooks (not *.sample) in .git/hooks
  case "$hd" in "") return 0 ;; /*) ;; *) hd="$TARGET/$hd" ;; esac
  for f in "$hd"/*; do [ ! -f "$f" ] || case "$f" in *.sample) ;; *) echo other; return 0 ;; esac; done
  return 0
}
hook_call() { # the line a manager's hook file uses to call one kit hook
  case "$1" in commit-msg) echo '.agent/scripts/kit-hook commit-msg "$1"' ;; pre-push) echo '.agent/scripts/kit-hook pre-push "$@"' ;; *) echo '.agent/scripts/kit-hook pre-commit' ;; esac
}
wire_husky() { # append the kit call to .husky/<hook> (create the file when missing); idempotent, keeps the existing commands
  local h f
  mkdir -p "$TARGET/.husky"
  for h in $KIT_HOOK_NAMES; do
    f="$TARGET/.husky/$h"
    if [ -f "$f" ]; then
      grep -qF 'kit-hook' "$f" && continue
      [ -z "$(tail -c1 "$f")" ] || printf '\n' >> "$f"
      printf '%s\n' "$(hook_call "$h")" >> "$f"
    else
      { printf '#!/usr/bin/env sh\n'; [ ! -f "$TARGET/.husky/_/husky.sh" ] || printf '. "$(dirname -- "$0")/_/husky.sh"\n'; printf '%s\n' "$(hook_call "$h")"; } > "$f"
    fi
    chmod +x "$f"
  done
  say "hooks: added the kit checks to .husky/pre-commit, commit-msg, pre-push (your commands there are untouched)"
}
hook_howto() { # what to add by hand for managers whose config the kit does not edit
  case "$1" in
    lefthook) printf '%s\n' "   - hooks: add to lefthook.yml (your lefthook keeps running; then:  lefthook install):" \
      "       pre-commit:  { commands: { agent-kit: { run: .agent/scripts/kit-hook pre-commit } } }" \
      "       commit-msg:  { commands: { agent-kit: { run: .agent/scripts/kit-hook commit-msg {1} } } }" \
      "       pre-push:    { commands: { agent-kit: { use_stdin: true, run: .agent/scripts/kit-hook pre-push {1} {2} } } }" ;;
    pre-commit) printf '%s\n' "   - hooks: in .pre-commit-config.yaml add (then run: pre-commit install — it installs both hook types):" \
      "       default_install_hook_types: [pre-commit, commit-msg]      # top level, next to repos:" \
      "       repos:" \
      "         - repo: local" \
      "           hooks:" \
      "             - { id: agent-kit, name: agent-kit, entry: .agent/scripts/kit-hook pre-commit, language: system, pass_filenames: false, always_run: true, stages: [pre-commit] }" \
      "             - { id: agent-kit-msg, name: agent-kit commit message, entry: .agent/scripts/kit-hook commit-msg, language: system, always_run: true, stages: [commit-msg] }" \
      "     (pre-push is not chained: pre-commit does not pass git's refs on stdin — protect main on the server)" ;;
    *) printf '%s\n' "   - hooks: your hook setup was left alone; from each hook call the kit (the same lines work for any manager):" \
      "       pre-commit: .agent/scripts/kit-hook pre-commit" "       commit-msg: .agent/scripts/kit-hook commit-msg \"\$1\"" \
      "       pre-push:   .agent/scripts/kit-hook pre-push \"\$@\"     (stdin must reach it)" ;;
  esac
}
setup_hooks() {
  local mode="$HOOKS" mgr; mgr="$(hook_manager)"
  [ "$mode" != auto ] || { [ -n "$mgr" ] && mode=keep || mode=kit; }
  if [ "$mode" = kit ]; then
    [ -z "$mgr" ] || note "hooks: found $mgr — --hooks kit points core.hooksPath at .githooks, so its hooks stop running (use --hooks keep to chain instead)"
    git config core.hooksPath .githooks
  elif [ "$mgr" = husky ]; then wire_husky
  else
    say "hooks: keeping your ${mgr:-own} hook setup — the kit's checks are chained through .agent/scripts/kit-hook"
    NOTES="$NOTES
$(hook_howto "$mgr")"
  fi
}

git_setup() {
  local cfg="$TARGET/.agent/project.yaml" mb has_head=0
  cd "$TARGET"
  if ! git rev-parse --git-dir >/dev/null 2>&1; then git init -q -b main; say "git init (main)"; fi
  setup_hooks
  git rev-parse -q --verify HEAD >/dev/null && has_head=1
  if [ $has_head -eq 1 ] && ! git show-ref -q --verify refs/heads/main && git show-ref -q --verify refs/heads/master; then
    sed -i.bak 's/^main_branch: main/main_branch: master/' "$cfg" && rm -f "$cfg.bak"; note "main branch is 'master' — project.yaml updated"
  fi
  mb="$(sed -n 's/^main_branch:[[:space:]]*\([^ ]*\).*/\1/p' "$cfg")"; mb="${mb:-main}"
  if [ "$FLOW" = auto ]; then   # an existing repo that has no develop branch (here or on origin) works trunk-based: do not invent one
    if [ $has_head -eq 1 ] && ! git show-ref -q --verify refs/heads/develop && ! git show-ref -q --verify refs/remotes/origin/develop; then FLOW=trunk; else FLOW=gitflow; fi
  fi
  if [ "$FLOW" = trunk ]; then
    sed -i.bak "s|^develop_branch:.*|develop_branch: $mb      # trunk-based: tasks branch from and merge into $mb|" "$cfg" && rm -f "$cfg.bak"
    say "flow: trunk-based — tasks branch from $mb and merge into it, no develop branch (--flow gitflow adds one)"
  elif [ $has_head -eq 1 ]; then
    git show-ref -q --verify refs/heads/develop || { git branch develop "$mb" 2>/dev/null && say "created branch develop from $mb"; } || true
  fi
  cd - >/dev/null
}

# ---------------------------------------------------------------- interactive selection
lbl() { printf '%s — %s' "$1" "$(printf '%s' "$2" | tr ',' ';' | cut -c1-100)"; }
pick_interactive() {
  local det ans s p f opts=() o more=y
  PROJECT_NAME="$(ui_input "Project name" "$PROJECT_NAME")"
  if [ ${#C_PATH[@]} -eq 0 ]; then
    det="$(detect_components "$TARGET")"
    if [ "$det" != ".=generic+" ]; then
      parse_components_str "$det"
      say "detected:"; describe_components
      ui_confirm "Use the detected components?" y || { C_PATH=(); C_STACK=(); C_FW=(); }
    fi
    while [ ${#C_PATH[@]} -eq 0 ] || [ "$more" = y ]; do
      [ ${#C_PATH[@]} -gt 0 ] && { ui_confirm "Add another component (e.g. frontend/ in a monorepo)?" n || break; }
      opts=(); for s in $(all_stacks); do opts+=("$(lbl "$s" "$(yget "$(stack_yaml "$s")" title)")"); done
      s="$(ui_one "Stack" "$(detect_stack "$TARGET")" "${opts[@]}")"
      p="$(ui_input "Path of this component (. = repo root)" "$( [ ${#C_PATH[@]} -eq 0 ] && echo . || echo frontend)")"
      f=""
      if [ -n "$(fw_list "$s")" ]; then
        opts=("none — plain $s"); for o in $(fw_list "$s"); do opts+=("$(lbl "$o" "$(yget "$(fw_dir "$s" "$o")/framework.yaml" title)")"); done
        f="$(ui_one "Framework" "$(detect_framework "$TARGET/$p" "$s")" "${opts[@]}")"; [ "$f" = none ] && f=""
      fi
      add_component "$p" "$s" "$f"
    done
  fi
  if [ -z "$MODS_FLAG" ]; then
    if [ -z "${PRESET_SET:-}" ]; then
      opts=(); for o in $PRESETS; do opts+=("$(lbl "$o" "$(preset_title "$o")")"); done
      PRESET="$(ui_one "Preset (module bundle — fine-tune next)" app "${opts[@]}")"
    fi
    opts=(); for o in $(all_modules); do opts+=("$(lbl "$o" "$(yget "$MODULES/$o/module.yaml" title)")"); done
    MODS="$(ui_many "Modules" "$(preset_modules "$PRESET")" "${opts[@]}")"
  fi
  if has_module devops && [ -z "$SERVICES_FLAG" ]; then
    opts=(); for o in $(all_services); do opts+=("$(lbl "$o" "$(svc_meta "$o" title)")"); done
    SERVICES="$(ui_many "Docker services for local dev" "postgres" "${opts[@]}")"
  fi
  LANG_DOCS="$(ui_one "Docs language" "$LANG_DOCS" "vi — Tiếng Việt" "en — English")"
}

# ---------------------------------------------------------------- commands
cmd_init() {
  TARGET=""; PROJECT_NAME=""; LANG_DOCS=vi; YES=0; DEPS=ask; SETUP=ask; TOOLS=ask; GITSETUP=1; HOOKS=auto; PROVIDER=auto; FLOW=auto
  local stack_flag="" fw_flag="" mode=auto; MODS_FLAG=""; SERVICES_FLAG=""; PRESET=app
  while [ $# -gt 0 ]; do
    case "$1" in
      --stack) stack_flag="$2"; shift 2 ;;
      --framework) fw_flag="$2"; shift 2 ;;
      --modules) MODS_FLAG="$2"; shift 2 ;;
      --preset) PRESET="$2"; PRESET_SET=1; shift 2 ;;
      --services) SERVICES_FLAG="$2"; shift 2 ;;
      --name) PROJECT_NAME="$2"; shift 2 ;;
      --lang) LANG_DOCS="$2"; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --deps) DEPS=yes; shift ;;
      --no-deps) DEPS=no; shift ;;
      --no-setup) SETUP=no; shift ;;
      --no-tools) TOOLS=no; shift ;;
      --install-tools) TOOLS=yes; shift ;;
      --force) FORCE=1; shift ;;
      --no-git) GITSETUP=0; shift ;;
      --provider) PROVIDER="${2:-}"; case "$PROVIDER" in github|gitlab|none|auto) ;; *) die "--provider takes github, gitlab, none or auto" ;; esac; shift 2 ;;
      --flow) FLOW="${2:-}"; case "$FLOW" in gitflow|trunk|auto) ;; *) die "--flow takes gitflow, trunk or auto" ;; esac; shift 2 ;;
      --hooks) HOOKS="${2:-}"; case "$HOOKS" in auto|kit|keep) ;; *) die "--hooks takes auto, kit or keep" ;; esac; shift 2 ;;
      --mode) mode="${2:-}"; case "$mode" in auto|new|existing) ;; *) die "--mode takes auto, new or existing" ;; esac; shift 2 ;;
      -h|--help) usage ;;
      -*) die "unknown option $1" ;;
      *) TARGET="$1"; shift ;;
    esac
  done
  [ -t 0 ] && [ -e /dev/tty ] && [ $YES -eq 0 ] && INTERACTIVE=1
  if [ -z "$TARGET" ]; then [ $INTERACTIVE -eq 1 ] && TARGET="$(ui_input "Project directory" "$PWD")" || usage 1; fi
  mkdir -p "$TARGET"; TARGET="$(cd "$TARGET" && pwd)"
  [ "$TARGET" = "$KIT_SRC" ] && die "target is the kit itself"
  PROJECT_NAME="${PROJECT_NAME:-$(basename "$TARGET")}"
  case "$mode" in
    existing) EXISTING=1 ;; new) EXISTING=0 ;;
    *) git -C "$TARGET" rev-parse -q --verify HEAD >/dev/null 2>&1 && EXISTING=1 || EXISTING=0 ;;
  esac
  [ $EXISTING -eq 0 ] || repo_snapshot   # before the kit writes a single file

  [ -n "$stack_flag" ] && parse_stack_flag "$stack_flag"
  [ -n "$fw_flag" ] && [ ${#C_PATH[@]} -eq 1 ] && { C_FW[0]="$fw_flag"; [ -n "$(fw_dir "${C_STACK[0]}" "$fw_flag")" ] || die "unknown framework $fw_flag"; }
  case "$MODS_FLAG" in "") MODS="$(preset_modules "$PRESET")" ;; default) MODS="$(default_modules)" ;; all) MODS="$(all_modules)" ;; none) MODS="" ;; *) MODS="$(echo "$MODS_FLAG" | tr ',' ' ')" ;; esac
  [ "$MODS_FLAG" = "" ] || MODS_FLAG=set
  SERVICES="$(echo "${SERVICES_FLAG:-postgres}" | tr ',' ' ')"; [ "$SERVICES_FLAG" = none ] && SERVICES=""

  if [ $INTERACTIVE -eq 1 ]; then
    printf '\n%sagent-kit %s%s — set up %s\n\n' "$B" "$VERSION" "$N" "$TARGET" >&2
    pick_interactive
  elif [ ${#C_PATH[@]} -eq 0 ]; then
    parse_components_str "$(detect_components "$TARGET")"
  fi
  [ $YES -eq 1 ] && { [ "$DEPS" = ask ] && DEPS=yes; [ "$SETUP" = ask ] && SETUP=yes; }
  [ $INTERACTIVE -eq 0 ] && { [ "$DEPS" = ask ] && DEPS=no; [ "$SETUP" = ask ] && SETUP=no; [ "$TOOLS" = ask ] && TOOLS=no; }
  [ $YES -eq 1 ] && [ "$TOOLS" = ask ] && TOOLS=no   # --yes never installs global software
  MODS="$(norm_mods $MODS)"
  for m in $MODS; do [ -d "$MODULES/$m" ] || die "unknown module '$m' (kit list)"; done

  printf '\n' >&2; say "target:     $TARGET"; say "components:"; describe_components
  say "modules:    ${MODS:-none}"; has_module devops && say "services:   ${SERVICES:-none}"; say "docs:       $LANG_DOCS"
  if [ $EXISTING -eq 1 ]; then say "mode:       existing repo — gates only for tools it already uses (--mode new = the full set-up)"
  else say "mode:       new project — full set-up"; fi
  if [ $INTERACTIVE -eq 1 ]; then ui_confirm "Install with this selection?" y || die "aborted"; fi

  resolve_provider; say "git host:  $PROVIDER"
  install_core
  local i; for i in "${!C_PATH[@]}"; do install_component "$i"; done
  for m in $MODS; do install_module_files "$m"; done
  build_commands
  [ $EXISTING -eq 0 ] || note_existing_gaps
  write_project_yaml
  apply_project_add
  render_module_placeholders
  has_module devops && generate_compose
  if [ "$PROVIDER" = github ]; then has_module devops && generate_cd; generate_dependabot
  elif [ "$PROVIDER" = gitlab ]; then NOTES="$NOTES
   - GitLab: no dependabot / cd workflow generated (use Renovate or GitLab dependency scanning; deploy stays a human step)"; fi
  wire_harnesses
  render_playbooks
  insert_ci_setup
  chmod +x "$TARGET"/.agent/scripts/* "$TARGET"/.agent/hooks/*.sh "$TARGET"/.githooks/* 2>/dev/null || true
  write_manifest
  [ $GITSETUP -eq 1 ] && git_setup
  run_tools
  [ "$DEPS" != no ] && run_dev_deps
  [ "$SETUP" != no ] && run_module_setup
  report
}

warn_ignored_kit_files() { # kit files the project's own .gitignore hides would exist on this machine only
  # every file the kit wrote (and the files it kept), grouped by folder: docs/ ignored as a whole hides ADRs, specs and the BA docs too
  local ign c
  git -C "$TARGET" rev-parse --git-dir >/dev/null 2>&1 || return 0
  ign="$( { printf '%s\n' "$RECORDED"; for c in $CONFLICTS; do printf '%s\n' "$c"; done; } | awk 'NF && !seen[$0]++' \
          | git -C "$TARGET" check-ignore --stdin 2>/dev/null \
          | awk -F/ '{ k = (NF > 1 ? $1 "/" : $1); if (!seen[k]++) printf " %s", k }' || true)"
  [ -z "$ign" ] || note "your .gitignore ignores kit files:$ign — they stay on this machine only (teammates and CI never see them). Remove those lines to share the kit with the team, or keep them to use it personally."
  return 0
}
report() {
  say "installed agent-kit $VERSION — $CREATED file(s) created"
  if [ -n "$CONFLICTS" ]; then
    note "existing files kept; kit versions written next to them as *.kit-new — merge by hand or ask the agent:"
    for c in $CONFLICTS; do printf '   - %s\n' "$c" >&2; done
  fi
  [ -n "$NOTES" ] && { note "to do:"; printf '%s\n' "$NOTES" | sed '/^$/d' >&2; }
  warn_ignored_kit_files
  if [ -x "$TARGET/.agent/scripts/kit-doctor" ]; then printf '\n' >&2; (cd "$TARGET" && .agent/scripts/kit-doctor >&2) || true; fi
  local mb db cur protect pr; mb="$(yget "$TARGET/.agent/project.yaml" main_branch)"; mb="${mb:-main}"
  db="$(yget "$TARGET/.agent/project.yaml" develop_branch)"; db="${db:-develop}"
  cur="$(git -C "$TARGET" branch --show-current 2>/dev/null || true)"
  if [ "$db" = "$mb" ]; then protect="$mb"; else protect="$mb + $db"; fi
  case "$PROVIDER" in gitlab) pr="MR" ;; github) pr="PR" ;; *) pr="review" ;; esac
  printf '\nNext steps\n' >&2
  if [ $EXISTING -eq 1 ]; then
    case "$cur" in
      *kit*) printf '  1. you are on %s — keep the kit set-up on this branch until its %s is merged\n' "$cur" "$pr" >&2 ;;
      *) printf '  1. git switch -c chore/agent-kit-setup   — the kit set-up gets its own branch and %s (not %s)\n' "$pr" "${cur:-$mb}" >&2 ;;
    esac
    printf '  2. Merge every *.kit-new into your file (or ask the agent), then delete the *.kit-new files — they are not committed\n' >&2
    printf '  3. Open your agent and say: "run kit-migrate, then kit-onboard"   (kit-migrate: your old agent rules/docs into the kit, from\n' >&2
    printf '     .agent/scripts/kit-adopt-scan; kit-onboard: context from the code, cmd_* aligned with your CI, baseline debt)\n' >&2
    printf '  4. Commit: git add -A && git commit -m "chore: add agent-kit" → %s into %s\n' "$pr" "$db" >&2
  else
    printf '  1. cd %s — commit: git add -A && git commit -m "chore: add agent-kit"\n' "$TARGET" >&2
    printf '  2. Open your agent and say: "run kit-ba, then kit-sa, then kit-plan"\n' >&2
  fi
  [ "$PROVIDER" = none ] || printf '  %s. On %s: protect %s (require a %s + the CI checks).\n' "$( [ $EXISTING -eq 1 ] && echo 5 || echo 3)" \
    "$( [ "$PROVIDER" = gitlab ] && echo GitLab || echo GitHub)" "$protect" "$pr" >&2
  return 0
}

cmd_add() {
  TARGET="."; YES=0; SETUP=ask; DEPS=no; local add="" SERVICES_ADD=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) TARGET="$2"; shift 2 ;;
      --services) SERVICES_ADD="$(echo "$2" | tr ',' ' ')"; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      -h|--help) usage ;;
      *) add="$add $1"; shift ;;
    esac
  done
  TARGET="$(cd "$TARGET" && pwd)"; local cfg="$TARGET/.agent/project.yaml"
  [ -f "$cfg" ] || die "$TARGET has no .agent/project.yaml — run kit init first"
  [ -n "$add" ] || die "usage: kit add <module…>   (kit list)"
  [ -t 0 ] && [ $YES -eq 0 ] && INTERACTIVE=1
  [ $YES -eq 1 ] && SETUP=yes; [ $INTERACTIVE -eq 0 ] && [ "$SETUP" = ask ] && SETUP=no
  PROJECT_NAME="$(yget "$cfg" name)"
  parse_components_str "$(yget "$cfg" components)"; [ ${#C_PATH[@]} -gt 0 ] || add_component . "$(yget "$cfg" stack)" ""
  local old m new=""; old="$(norm_mods $(yget "$cfg" modules))"; add="$(norm_mods $add)"
  for m in $add; do [ -d "$MODULES/$m" ] || die "unknown module '$m'"; case " $old " in *" $m "*) note "module $m already installed — refreshing files";; esac; new="$new $m"; done
  MODS="$(echo $old $new | tr ' ' '\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//')"
  SERVICES="${SERVICES_ADD:-$(yget "$TARGET/.agent/kit.lock" services)}"
  case " $new " in *" devops "*) [ -z "$SERVICES" ] && [ $INTERACTIVE -eq 1 ] && {
      local opts=() o; for o in $(all_services); do opts+=("$(lbl "$o" "$(svc_meta "$o" title)")"); done
      SERVICES="$(ui_many "Docker services for local dev" "postgres" "${opts[@]}")"; } ;; esac
  resolve_provider
  for m in $new; do install_module_files "$m"; done
  case " $new " in *" devops "*)
    local i; for i in "${!C_PATH[@]}"; do src="$(comp_dockerfile "$i")"; [ -n "$src" ] && copy_file "$src" "$TARGET/${C_PATH[$i]}/Dockerfile"; done
    generate_compose ;; esac
  sed -i.bak "s#^modules:.*#modules: $MODS#" "$cfg" && rm -f "$cfg.bak"
  grep -q '^modules:' "$cfg" || echo "modules: $MODS" >> "$cfg"
  apply_project_add
  LANG_DOCS="$(yget "$cfg" docs_language)"; render_module_placeholders
  wire_harnesses
  render_playbooks
  [ -f "$TARGET/.agent/kit.lock" ] && { sed -i.bak "s#^modules:.*#modules: $MODS#; s#^services:.*#services: $SERVICES#" "$TARGET/.agent/kit.lock"; rm -f "$TARGET/.agent/kit.lock.bak"; }
  local keep="$MODS"; MODS="$new"; [ "$SETUP" != no ] && run_module_setup; MODS="$keep"
  say "added:$new — $CREATED file(s) created"
  [ -n "$CONFLICTS" ] && { note "kept existing files, wrote *.kit-new:"; for c in $CONFLICTS; do printf '   - %s\n' "$c" >&2; done; }
  [ -n "$NOTES" ] && printf '%s\n' "$NOTES" | sed '/^$/d' >&2
  return 0
}

cmd_list() {
  local s f m sv
  printf '%sStacks%s (kit init --stack stack[:path[:framework]])\n' "$B" "$N"
  for s in $(all_stacks); do
    printf '  %-12s %s\n' "$s" "$(yget "$(stack_yaml "$s")" title)"
    for f in $(fw_list "$s"); do printf '  %-12s   + %-8s %s\n' "" "$f" "$(yget "$(fw_dir "$s" "$f")/framework.yaml" title)"; done
  done
  printf '\n%sPresets%s (--preset; default app)\n' "$B" "$N"
  for m in $PRESETS; do printf '  %-10s %s  [%s]\n' "$m" "$(preset_title "$m")" "$(preset_modules "$m")"; done
  printf '\n%sModules%s (--modules; * = default)\n' "$B" "$N"
  for m in $(all_modules); do printf '  %-10s %s %s\n' "$m" "$( [ "$(yget "$MODULES/$m/module.yaml" default)" = true ] && echo '*' || echo ' ')" "$(yget "$MODULES/$m/module.yaml" title)"; done
  printf '\n%sDocker services%s (--services, module devops)\n' "$B" "$N"
  for sv in $(all_services); do printf '  %-14s %s\n' "$sv" "$(svc_meta "$sv" title)"; done
}

cmd_upgrade() {
  TARGET="."; local dirty_ok=0
  while [ $# -gt 0 ]; do case "$1" in --allow-dirty) dirty_ok=1; shift ;; -h|--help) usage ;; *) TARGET="$1"; shift ;; esac; done
  TARGET="$(cd "$TARGET" && pwd)"; local cfg="$TARGET/.agent/project.yaml" lock="$TARGET/.agent/kit.lock"
  [ -f "$cfg" ] && [ -f "$lock" ] || die "$TARGET is not an agent-kit project (missing .agent/project.yaml or kit.lock)"
  if [ $dirty_ok -eq 0 ] && [ -n "$(git -C "$TARGET" status --porcelain 2>/dev/null)" ]; then die "commit or stash first so the upgrade is a reviewable diff (or --allow-dirty)"; fi
  [ -f "$TARGET/.agent/kit.manifest" ] || note "no kit.manifest (installed before kit 0.10): every changed kit file is written as *.kit-new for you to merge"
  local from; from="$(yget "$lock" kit_version)"
  UPGRADE=1; PROJECT_NAME="$(yget "$cfg" name)"; LANG_DOCS="$(yget "$cfg" docs_language)"; LANG_DOCS="${LANG_DOCS:-vi}"
  MODS="$(norm_mods $(yget "$lock" modules))"; SERVICES="$(yget "$lock" services)"
  parse_components_str "$(yget "$lock" components)"; [ ${#C_PATH[@]} -gt 0 ] || add_component . "$(yget "$cfg" stack)" ""
  say "upgrading $TARGET: kit $from → $VERSION · modules: $MODS"
  resolve_provider
  install_core
  local i; for i in "${!C_PATH[@]}"; do install_component "$i"; done
  for m in $MODS; do install_module_files "$m"; done
  build_commands; sync_project_keys; apply_project_add; render_module_placeholders
  wire_harnesses; render_playbooks; insert_ci_setup
  chmod +x "$TARGET"/.agent/scripts/* "$TARGET"/.agent/hooks/*.sh "$TARGET"/.githooks/* 2>/dev/null || true
  write_manifest
  sed -i.bak "s/^kit_version:.*/kit_version: $VERSION/" "$lock" && rm -f "$lock.bak"
  sed -i.bak "s/^kit_version:.*/kit_version: $VERSION/" "$cfg" && rm -f "$cfg.bak"
  local changed; changed="$(git -C "$TARGET" status --porcelain 2>/dev/null | grep -v '\.kit-new$' | grep -c . || true)"
  say "upgrade done: ${changed:-?} file(s) changed (git status) · $(echo $CONFLICTS | wc -w | tr -d ' ') kept with your edits (kit version in *.kit-new)"
  for c in $CONFLICTS; do printf '   - %s\n' "$c" >&2; done
  say "review: git -C $TARGET diff --stat  ·  then commit on a branch: chore/kit-upgrade-$VERSION"
}

cmd_tools() {
  local dir="." args=()
  while [ $# -gt 0 ]; do case "$1" in install|status|ensure|--yes) args+=("$1") ;; *) if [ -d "$1" ]; then dir="$1"; else args+=("$1"); fi ;; esac; shift; done
  [ -x "$dir/.agent/scripts/kit-tools" ] || die "$dir is not an agent-kit project (or predates kit-tools — run kit init again)"
  cd "$dir" && exec .agent/scripts/kit-tools ${args[@]+"${args[@]}"}
}

cmd_doctor() {
  local dir="." args=()
  while [ $# -gt 0 ]; do case "$1" in --*) args+=("$1") ;; *) dir="$1" ;; esac; shift; done
  [ -x "$dir/.agent/scripts/kit-doctor" ] || die "$dir is not an agent-kit project"
  cd "$dir" && exec .agent/scripts/kit-doctor ${args[@]+"${args[@]}"}
}

case "${1:-}" in
  init)   shift; cmd_init "$@" ;;
  add)    shift; cmd_add "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  tools)  shift; cmd_tools "$@" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  list)   cmd_list ;;
  version|--version) echo "$VERSION" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$1' — see: kit --help" ;;
esac
