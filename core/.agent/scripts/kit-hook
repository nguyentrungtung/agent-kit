#!/usr/bin/env bash
# kit-hook <pre-commit|commit-msg|pre-push> [hook args…] — the agent-kit git checks as ONE entry point any hook manager can call.
# `kit init` installs them as git hooks itself (core.hooksPath → .githooks). If the repo already uses Husky, lefthook or another
# manager (`kit init --hooks keep`), that manager keeps ownership and just calls this script, e.g.
#   .husky/pre-commit   .agent/scripts/kit-hook pre-commit
#   .husky/commit-msg   .agent/scripts/kit-hook commit-msg "$1"
#   .husky/pre-push     .agent/scripts/kit-hook pre-push "$@"          (stdin = the refs git passes; do not swallow it)
# Pure local git — works the same on GitHub, GitLab (cloud or self-hosted), Bitbucket, Gitea.
set -euo pipefail
root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "[kit] kit-hook: not inside a git repository" >&2; exit 1; }
name="${1:-}"
case "$name" in
  pre-commit|commit-msg|pre-push) shift ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
hook="$root/.githooks/$name"
[ -x "$hook" ] || { echo "[kit] kit-hook: $hook is missing or not executable — run: kit upgrade (or chmod +x .githooks/*)" >&2; exit 1; }
exec "$hook" "$@"
