#!/usr/bin/env bash
# kit-board [--ready] [--json | --html [file] | --open] — task board from .agent/tasks across all task branches
#   (default) kanban in the terminal: TODO · IN PROGRESS · REVIEW · DONE (+ abandoned count)
#   --ready   filter terminal/--json output to runnable todo tasks (no unmet depends_on)
#   --json    machine-readable list (stable schema, see .agent/tasks/README.md) — for UIs / orchestrators
#   --html    self-contained board page (default .agent/local/board.html, git-ignored); --open also opens it
# Status is read from each task's own branch (where kit-task records it); merged review tasks show as done.
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"

mode=text; ready=0; out="$KIT_DIR/local/board.html"; open=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ready) ready=1; shift ;;
    --json) mode=json; shift ;;
    --html) mode=html; shift; [ $# -gt 0 ] && [ "${1#--}" = "$1" ] && { out="$1"; shift; } ;;
    --open) mode=html; open=1; shift ;;
    -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option $1" ;;
  esac
done
[ $ready -eq 1 ] && [ "$mode" = html ] && die "--ready supports terminal and --json output only (not --html/--open)"

fmv_list() { fmv "$1" "$2" | sed -E 's/(^|[[:space:]]+)#.*$//' | tr -d "\r\t[]\"' "; }

# collect one TSV row per task: id status prio type title branch worktree issue goal deps started done points dirty file
rows="$(mktemp)"; trap 'rm -f "$rows" "$rows.u" "$rows.r"' EXIT
for name in $(task_names_all); do
  c="$(task_view "$name")"; [ -n "$c" ] || continue
  id="$(fmv "$c" id)"; [ -n "$id" ] || continue
  st="$(task_effective_status "$c")"
  br="$(fmv "$c" branch)"; [ -n "$br" ] || br="$(task_branch "$id")"
  pts="$(git tag -l "kit/$id/cp-*" | grep -c . || true)"
  wt="$(fmv "$c" worktree)"; dirty=""
  if [ -n "$wt" ] && [ -d "$KIT_ROOT/$wt" ]; then dirty="$(git -C "$KIT_ROOT/$wt" status --porcelain 2>/dev/null | grep -c . || true)"; else wt=""; fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$id" "$st" "$(fmv "$c" priority)" "$(fmv "$c" type)" "$(fmv "$c" title | tr '\r\t' '  ')" "$br" "$wt" "$(issue_of "$id" "$c")" \
    "$(fmv "$c" goal_ref)" "$(fmv_list "$c" depends_on)" "$(fmv "$c" started)" "$(fmv "$c" done)" "${pts:-0}" "$dirty" "$name" \
    "$(fmv_list "$c" tags)" >> "$rows"
done

# keep only unmet dependencies (deps whose task is not done)
awk -F'\t' -v OFS='\t' 'NR==FNR {st[$1]=$2; next} {
  n = split($10, a, ","); o = ""
  for (i = 1; i <= n; i++) if (a[i] != "" && st[a[i]] != "done") o = o (o == "" ? "" : ",") a[i]
  $10 = o; print }' "$rows" "$rows" > "$rows.u" && mv "$rows.u" "$rows"
if [ $ready -eq 1 ]; then
  awk -F'\t' '$2=="todo" && $10==""' "$rows" > "$rows.r" && mv "$rows.r" "$rows"
fi

json() {
  local repo; repo="$(git remote get-url origin 2>/dev/null | sed -E 's#^git@github.com:#https://github.com/#; s#\.git$##' || true)"
  awk -F'\t' -v name="$(cfg name "$(basename "$KIT_ROOT")")" -v repo="$repo" -v gen="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    function esc(s) { gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s); return s }
    function str(s) { return (s=="") ? "null" : "\"" esc(s) "\"" }
    function deps(s,  a,n,i,o) { if (s=="") return "[]"; n=split(s,a,","); o="["; for(i=1;i<=n;i++) { gsub(/^[[:space:]]+|[[:space:]]+$/,"",a[i]); o=o (i>1?",":"") "\"" esc(a[i]) "\""; } return o "]" }
    BEGIN { printf "{\"project\":%s,\"repo\":%s,\"generated\":\"%s\",\"tasks\":[", str(name), str(repo), gen }
    { printf "%s{\"id\":%s,\"status\":%s,\"priority\":%s,\"type\":%s,\"tags\":%s,\"title\":%s,\"branch\":%s,\"worktree\":%s,\"issue\":%s,\"goal_ref\":%s,\"depends_on\":%s,\"started\":%s,\"done\":%s,\"checkpoints\":%d,\"dirty_files\":%s,\"file\":%s}",
        (NR>1?",":""), str($1), str($2), str($3), str($4), deps($16), str($5), str($6), str($7), ($8==""?"null":$8), str($9), deps($10), str($11), str($12), $13, ($14==""?"null":$14), str($15) }
    END { print "]}" }' "$rows"
}

case "$mode" in
  json) json; exit 0 ;;
  text)
    if [ $ready -eq 1 ]; then
      n="$(grep -c . "$rows" || true)"
      printf '\n%sREADY TODO%s (%s)\n' "$c_grn" "$c_off" "$n"
      [ "$n" -eq 0 ] && printf '  %s(no runnable todo tasks — check in-progress/depends_on)%s\n' "$c_dim" "$c_off"
      sort -t"$(printf '\t')" -k3,3 -k1,1 "$rows" | awk -F'\t' -v dim="$c_dim" -v off="$c_off" '{
        x = ""; if ($8 != "") x = x " #" $8; if ($16 != "") x = x " [" $16 "]"
        printf "  %-9s %-3s %s%s%s%s\n", $1, $3, $5, dim, x, off }'
      echo; exit 0
    fi
    for col in todo in-progress review done; do
      n="$(awk -F'\t' -v s="$col" '$2==s' "$rows" | grep -c . || true)"
      printf '\n%s%s%s (%s)\n' "$c_grn" "$(printf '%s' "$col" | tr '[:lower:]-' '[:upper:] ')" "$c_off" "$n"
      awk -F'\t' -v s="$col" '$2==s' "$rows" | sort -t"$(printf '\t')" -k3,3 -k1,1 | awk -F'\t' -v dim="$c_dim" -v off="$c_off" '{
        x = ""; if ($8 != "") x = x " #" $8
        if ($7 != "") { x = x " ⎇ " $7; if ($14 != "" && $14 > 0) x = x " (" $14 " dirty)" }
        if ($2 == "in-progress") x = x " cp:" $13
        if ($16 != "") x = x " [" $16 "]"
        if ($10 != "" && $2 == "todo") x = x " ⟵ needs " $10
        printf "  %-9s %-3s %s%s%s%s\n", $1, $3, $5, dim, x, off }'
    done
    ab="$(awk -F'\t' '$2=="abandoned"' "$rows" | grep -c . || true)"; [ "${ab:-0}" -gt 0 ] && printf '\n%s(%s abandoned)%s\n' "$c_dim" "$ab" "$c_off"
    echo; exit 0 ;;
esac

# ---- html ----
mkdir -p "$(dirname "$out")"
data="$(json | sed 's#</#<\\/#g')"
cat > "$out" <<HTML
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Task board</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--fg:#1f2328;--mut:#656d76;--line:#d0d7de;--todo:#8c959f;--prog:#bf8700;--rev:#0969da;--done:#1a7f37}
@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--card:#161b22;--fg:#e6edf3;--mut:#8d96a0;--line:#30363d;--todo:#8d96a0;--prog:#d29922;--rev:#4493f8;--done:#3fb950}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 system-ui,-apple-system,Segoe UI,sans-serif}
header{padding:16px;display:flex;gap:12px;align-items:baseline;flex-wrap:wrap}h1{font-size:18px;margin:0}.meta{color:var(--mut);font-size:12px}
input{margin-left:auto;padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:var(--card);color:var(--fg);min-width:200px}
.board{display:grid;grid-template-columns:repeat(4,minmax(240px,1fr));gap:12px;padding:0 16px 16px;overflow-x:auto}
.col{background:transparent;min-width:0}.col h2{font-size:13px;text-transform:uppercase;letter-spacing:.04em;margin:0 0 8px;display:flex;gap:6px;align-items:center}
.dot{width:8px;height:8px;border-radius:50%}.n{color:var(--mut);font-weight:400}
.card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:8px}
.card .top{display:flex;justify-content:space-between;color:var(--mut);font-size:12px}.card .t{margin:4px 0 6px;font-weight:500}
.tags{display:flex;gap:6px;flex-wrap:wrap;font-size:11px;color:var(--mut)}.tag{border:1px solid var(--line);border-radius:10px;padding:0 6px}
.P1{color:#cf222e;border-color:#cf222e}a{color:inherit}
@media (max-width:700px){.board{grid-template-columns:1fr}}
</style></head><body>
<header><h1 id="p"></h1><span class="meta" id="g"></span><input id="q" placeholder="Filter (id, title, label)…" aria-label="Filter tasks"></header>
<main class="board" id="b"></main>
<script id="data" type="application/json">$data</script>
<script>
const D=JSON.parse(document.getElementById('data').textContent);
const COLS=[['todo','To do','--todo'],['in-progress','In progress','--prog'],['review','In review','--rev'],['done','Done','--done']];
document.getElementById('p').textContent=D.project+' — tasks';
document.getElementById('g').textContent='generated '+D.generated+' · refresh: .agent/scripts/kit-board --html';
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function render(q){
  q=(q||'').toLowerCase();
  document.getElementById('b').innerHTML=COLS.map(([k,l,v])=>{
    const ts=D.tasks.filter(t=>t.status===k&&(!q||JSON.stringify(t).toLowerCase().includes(q)));
    return '<section class="col"><h2><span class="dot" style="background:var('+v+')"></span>'+l+' <span class="n">'+ts.length+'</span></h2>'+
      ts.map(t=>'<article class="card"><div class="top"><span>'+esc(t.id)+'</span><span>'+
        (t.issue&&D.repo?'<a href="'+esc(D.repo)+'/issues/'+t.issue+'">#'+t.issue+'</a>':(t.issue?'#'+t.issue:''))+'</span></div>'+
        '<div class="t">'+esc(t.title)+'</div><div class="tags">'+
        (t.tags&&t.tags.length?t.tags.map(x=>'<span class="tag">#'+esc(x)+'</span>').join(''):'')+
        (t.priority?'<span class="tag '+esc(t.priority)+'">'+esc(t.priority)+'</span>':'')+(t.type?'<span class="tag">'+esc(t.type)+'</span>':'')+
        (t.goal_ref?'<span class="tag">'+esc(t.goal_ref)+'</span>':'')+(t.status==='in-progress'?'<span class="tag">cp '+t.checkpoints+'</span>':'')+
        (t.worktree?'<span class="tag" title="worktree">⎇ '+esc(t.worktree)+(t.dirty_files?' · '+t.dirty_files+' dirty':'')+'</span>':'')+
        (t.depends_on.length&&t.status==='todo'?'<span class="tag">needs '+esc(t.depends_on.join(', '))+'</span>':'')+
        '</div></article>').join('')+'</section>';
  }).join('');
}
document.getElementById('q').addEventListener('input',e=>render(e.target.value));render('');
</script></body></html>
HTML
info "board written to ${out#"$KIT_ROOT"/}"
if [ $open -eq 1 ]; then (command -v open >/dev/null && open "$out") || (command -v xdg-open >/dev/null && xdg-open "$out") || true; fi
