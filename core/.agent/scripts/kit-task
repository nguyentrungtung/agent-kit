#!/usr/bin/env bash
# kit-task — task lifecycle with gitflow branches, checkpoints and safe rollback
#
#   kit-task new "<title>" [--type feature|fix|hotfix|refactor|chore|docs|test] [--priority P1|P2|P3] [--change <openspec-change>]
#   kit-task verify [TASK-ID]         check the workflow gates (source, clarify checklist, solution, tests, result, AC,
#                                     assumptions, traceability, living docs, change). CI runs it on every task PR.
#   kit-task start <TASK-ID> [--worktree]  create <type>/<TASK-ID>-<slug> from develop (hotfix: from main), tag base
#                                     --worktree: in a separate git worktree ../<repo>-<TASK-ID> (parallel agents)
#   kit-task worktrees                list task worktrees
#   kit-task cleanup <TASK-ID>        remove the task's worktree (refuses if it has uncommitted work)
#   kit-task sync-gh [TASK-ID|--all]  create/update GitHub issues from task files (labels, close when done)
#   kit-task pull-gh <issue#>         create a task file from a GitHub issue
#   kit-task checkpoint "<msg>"       commit all work + tag kit/<id>/cp-N  (a restore point)
#   kit-task rollback [--to base|cp-N] reset current task branch to a restore point (backup branch kept)
#   kit-task points                   list restore points of the current task
#   kit-task finish                   run checks, push, open PR to develop (or main for hotfix)
#   kit-task merged <TASK-ID>         after the PR is merged: tag the merge commit (enables revert)
#   kit-task revert <TASK-ID>         undo a merged task: create revert branch + PR
#   kit-task abandon                  drop the current task branch (backup branch kept)
#   kit-task status | list
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"
mkdir -p "$KIT_TASKS"

has_remote() { git remote | grep -qx "${KIT_REMOTE:-origin}"; }
remote() { printf '%s' "${KIT_REMOTE:-origin}"; }
require_clean() {
  git diff --quiet && git diff --cached --quiet || die "working tree has uncommitted changes — run: kit-task checkpoint \"<msg>\" (or stash) first"
}
PLANNING_RE='^(docs/|openspec/|\.agent/(tasks|memory|context)/)'
require_clean_code() { # planning docs (BA, specs, changes, tasks, ADRs) may travel into the task branch; code may not
  local dirty
  dirty="$(git status --porcelain | cut -c4- | sed 's/.* -> //' | grep -vE "$PLANNING_RE" || true)"
  [ -z "$dirty" ] || die "uncommitted code changes — checkpoint or stash them first:
$(printf '%s\n' "$dirty" | head -n 10 | sed 's/^/   /')"
}
require_task_branch() {
  local id; id="$(task_from_branch)"
  [ -n "$id" ] || die "not on a task branch (expected <type>/TASK-NNN-slug). Current: $(current_branch)"
  is_protected "$(current_branch)" && die "refusing to operate on protected branch $(current_branch)"
  printf '%s' "$id"
}
slugify() { ascii_slug "$1" 40; }
log_progress() { # log_progress <file> <text>
  local f="$1"; shift
  if grep -q '^## Progress log' "$f"; then
    awk -v line="- $(now) — $*" '{print} /^## Progress log/{print line}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  else printf '\n## Progress log\n- %s — %s\n' "$(now)" "$*" >> "$f"; fi
}
base_for_type() { [ "$1" = hotfix ] && main_branch || develop_branch; }
next_cp() { local n; n="$(git tag -l "kit/$1/cp-*" | sed 's/.*cp-//' | sort -n | tail -n1 || true)"; echo $(( ${n:-0} + 1 )); }

# is_merged <task-file> — true if the task's branch tip is contained in develop or main
is_merged() {
  local br tip; br="$(fm_get "$1" branch)"; [ -n "$br" ] || return 1
  tip="$(git rev-parse -q --verify "refs/heads/$br" || git rev-parse -q --verify "refs/remotes/$(remote)/$br" || true)"
  [ -n "$tip" ] || return 1
  git merge-base --is-ancestor "$tip" "$(develop_branch)" 2>/dev/null || git merge-base --is-ancestor "$tip" "$(main_branch)" 2>/dev/null
}

# Mark review tasks that are merged as done, then move done/abandoned tasks to .agent/tasks/archive/YYYY-MM/
# (so agents don't read finished work as current truth). Writes files → only called right before a commit (kit-task start).
sync_done() {
  local f st month
  for f in "$KIT_TASKS"/TASK-*.md; do
    [ -f "$f" ] || continue
    st="$(fm_get "$f" status)"
    if [ "$st" = review ] && is_merged "$f"; then
      fm_set "$f" status "done"; fm_set "$f" "done" "$(today)"; st=done; info "$(basename "$f" .md) → done (merged)"
    fi
    case "$st" in done|abandoned) ;; *) continue ;; esac
    month="$(fm_get "$f" "done" | cut -c1-7)"; [ -n "$month" ] || month="$(date +%Y-%m)"
    mkdir -p "$KIT_TASKS/archive/$month"
    git mv -k "$f" "$KIT_TASKS/archive/$month/" 2>/dev/null || mv "$f" "$KIT_TASKS/archive/$month/"
    info "$(basename "$f" .md) → archive/$month"
  done
}

cmd_new() {
  local title="" type=feature prio=P2 change="" tags="[]"
  while [ $# -gt 0 ]; do case "$1" in
    --type) type="$2"; shift 2 ;; --priority) prio="$2"; shift 2 ;; --change) change="$2"; shift 2 ;; --tags) tags="$2"; shift 2 ;; *) title="${title:+$title }$1"; shift ;;
  esac; done
  [ -n "$title" ] || die 'usage: kit-task new "<title>" [--type feature] [--priority P2] [--change <openspec-change>] [--tags <tags>]'
  if [ -n "$change" ] && [ ! -d "$(change_dir "$change")" ]; then warn "OpenSpec change '$change' not found under openspec/changes/ (create it: kit-new change $change)"; fi
  local last n id f
  last="$(task_names_all | xargs -n1 basename 2>/dev/null | grep -oE '^TASK-[0-9]+' | sed 's/TASK-//' | sort -n | tail -n1 || true)"
  n=$(( 10#${last:-0} + 1 )); id="$(printf 'TASK-%03d' "$n")"
  f="$KIT_TASKS/$id-$(slugify "$title").md"
  local t_esc; t_esc="$(printf '%s' "$title" | sed 's/[\/&|]/\\&/g')"
  case "$tags" in \[*\]) ;; *) tags="[$tags]" ;; esac
  sed -e "s/{{ID}}/$id/g" -e "s/{{TITLE}}/$t_esc/g" -e "s/{{TYPE}}/$type/g" -e "s/{{PRIORITY}}/$prio/g" -e "s/{{DATE}}/$(today)/g" -e "s/{{CHANGE}}/$change/g" -e "s/{{TAGS}}/$tags/g" \
    "$KIT_TASKS/_TEMPLATE.md" > "$f"
  info "created $f"
  echo "$id"
}

cmd_start() {
  local id="" wt=0
  while [ $# -gt 0 ]; do case "$1" in --worktree|-w) wt=1; shift ;; *) id="$1"; shift ;; esac; done
  [ -n "$id" ] || die "usage: kit-task start TASK-NNN [--worktree]"
  local f; f="$(task_file "$id")"; [ -f "$f" ] || die "task file for $id not found in .agent/tasks"
  local type base br
  type="$(fm_get "$f" type)"; type="${type:-feature}"
  base="$(base_for_type "$type")"
  git show-ref --verify -q "refs/heads/$base" || die "base branch '$base' missing (run install or: git branch $base $(main_branch))"
  if [ $wt -eq 1 ]; then start_worktree "$id" "$f" "$type" "$base"; return; fi
  require_clean_code
  br="$(fm_get "$f" branch)"
  if [ -n "$br" ] && git show-ref --verify -q "refs/heads/$br"; then
    git checkout -q "$br"; info "resumed $br"; return
  fi
  git checkout -q "$base"
  if has_remote; then git pull -q --ff-only "$(remote)" "$base" 2>/dev/null || warn "could not fast-forward $base from remote (offline?)"; fi
  sync_done
  br="$type/$id-$(slugify "$(fm_get "$f" title)")"
  git checkout -q -b "$br"
  git tag -f "kit/$id/base" >/dev/null
  fm_set "$f" status in-progress; fm_set "$f" branch "$br"; fm_set "$f" started "$(today)"
  log_progress "$f" "started on $br (base: $base @ $(git rev-parse --short HEAD))"
  # the task file + any planning docs written on the base branch (BA, ADR, OpenSpec change) travel with the first commit
  git add -A "$KIT_TASKS" "$KIT_DIR/memory" "$KIT_DIR/context" 2>/dev/null || true
  [ -d "$KIT_ROOT/docs" ] && git add -A "$KIT_ROOT/docs"
  [ -d "$KIT_ROOT/openspec" ] && git add -A "$KIT_ROOT/openspec"
  git commit -q -m "chore($id): start task" || true
  info "on $br — restore point kit/$id/base created"
  local ch; ch="$(fm_get "$f" change)"
  [ -n "$ch" ] && info "OpenSpec change: openspec/changes/$ch/ (proposal, specs, design, tasks) — read it before coding"
  local tags; tags="$(fm_get "$f" tags | tr -d '[] ' | tr ',' '|')"
  if [ -n "$tags" ] && [ -f "$KIT_DIR/memory/LESSONS.md" ]; then
    if grep -iE "\[($tags)\]" "$KIT_DIR/memory/LESSONS.md" >/dev/null 2>&1; then
      info "Relevant lessons for [$tags] (.agent/memory/LESSONS.md):"
      grep -iE "\[($tags)\]" "$KIT_DIR/memory/LESSONS.md" | head -n 5 | sed 's/^/  • /' || true
    fi
  fi
  return 0
}

wt_path_for() { # existing worktree path whose branch contains <id>
  git worktree list --porcelain | awk -v id="$1" '/^worktree /{p=substr($0,10)} /^branch /{ if (index($0, "/" id "-")) print p }' | head -n1
}

start_worktree() { # start_worktree <id> <task-file> <type> <base>
  local id="$1" f="$2" type="$3" base="$4" br path rel from
  path="$(wt_path_for "$id")"
  if [ -n "$path" ]; then info "worktree already exists: $path"; echo "$path"; return; fi
  br="$(task_branch "$id")"; case "$br" in */*/*) br="${br#*/}" ;; esac   # remote name → local
  [ -n "$br" ] || br="$type/$id-$(slugify "$(fm_get "$f" title)")"
  path="$(dirname "$KIT_ROOT")/$(basename "$KIT_ROOT")-$id"
  [ -e "$path" ] && die "$path already exists — move it away or remove it first"
  from="$base"
  if has_remote; then
    git fetch -q "$(remote)" "$base" 2>/dev/null || warn "could not fetch $base (offline?)"
    git rev-parse -q --verify "refs/remotes/$(remote)/$base" >/dev/null && from="$(remote)/$base"
  fi
  if git show-ref --verify -q "refs/heads/$br"; then git worktree add -q "$path" "$br"
  else git worktree add -q -b "$br" "$path" "$from"; git -C "$path" tag -f "kit/$id/base" >/dev/null; fi
  rel="${f#"$KIT_ROOT"/}"
  [ -f "$path/$rel" ] || { mkdir -p "$(dirname "$path/$rel")"; cp "$f" "$path/$rel"; }
  fm_set "$path/$rel" status in-progress; fm_set "$path/$rel" branch "$br"
  fm_set "$path/$rel" worktree "../$(basename "$path")"; fm_set "$path/$rel" started "$(today)"
  log_progress "$path/$rel" "started in worktree ../$(basename "$path") on $br (base: $from)"
  ( cd "$path" && git add -A .agent/tasks && git commit -q -m "chore($id): start task (worktree)" ) || true
  info "worktree ready: $path  (branch $br, restore point kit/$id/base)"
  info "next: cd $path && .agent/scripts/kit-run install   — then open a NEW agent session in that folder"
  echo "$path"
}

cmd_worktrees() {
  git worktree list | while IFS= read -r l; do
    id="$(printf '%s' "$l" | grep -oE 'TASK-[0-9]+' | head -n1 || true)"
    if [ -n "$id" ]; then printf '%s  [%s]\n' "$l" "$(git -C "$(printf '%s' "$l" | awk '{print $1}')" status --porcelain | wc -l | tr -d ' ') dirty"; else printf '%s  (main)\n' "$l"; fi
  done
}

cmd_cleanup() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: kit-task cleanup TASK-NNN"
  local path br; path="$(wt_path_for "$id")"; [ -n "$path" ] || die "no worktree for $id (kit-task worktrees)"
  [ "$path" = "$KIT_ROOT" ] && die "you are inside that worktree — run cleanup from the main checkout"
  [ -z "$(git -C "$path" status --porcelain)" ] || die "$path has uncommitted work — checkpoint or abandon it first"
  br="$(git -C "$path" rev-parse --abbrev-ref HEAD)"
  git worktree remove "$path" && info "removed worktree $path (branch $br kept$(branch_merged "$br" && echo ', merged'))"
}

cmd_checkpoint() {
  local id msg="${1:-wip}"; id="$(require_task_branch)"
  if git diff --quiet && git diff --cached --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    info "nothing to checkpoint"; return
  fi
  local n; n="$(next_cp "$id")"
  log_progress "$(task_file "$id")" "checkpoint cp-$n: $msg"
  git add -A
  git commit -q -m "chore($id): checkpoint $n - $msg" || die "commit blocked (see hook output above)"
  git tag -f "kit/$id/cp-$n" >/dev/null
  if [ "$(cfg push_checkpoints true)" = true ] && has_remote; then
    if git push -q -u "$(remote)" "$(current_branch)" 2>/dev/null; then info "pushed backup to $(remote)"; else warn "push failed (offline?) — checkpoint is local only"; fi
  fi
  info "restore point kit/$id/cp-$n"
}

cmd_points() {
  local id; id="$(require_task_branch)"
  git for-each-ref --sort=creatordate --format='%(refname:short)  %(creatordate:short)  %(subject)' "refs/tags/kit/$id/"
}

cmd_rollback() {
  local id to=""; id="$(require_task_branch)"
  [ "${1:-}" = --to ] && to="${2:-}"
  local tag
  if [ -z "$to" ]; then
    # default: latest checkpoint; if HEAD already sits on it (nothing after it), go one further back
    local cps; cps="$(git tag -l "kit/$id/cp-*" | sort -t- -k3 -n)"
    tag="$(printf '%s\n' "$cps" | tail -n1)"
    if [ -n "$tag" ] && [ "$(git rev-parse "$tag^{commit}")" = "$(git rev-parse HEAD)" ] && git diff --quiet && git diff --cached --quiet; then
      tag="$(printf '%s\n' "$cps" | tail -n2 | sed -n '1p')"
      [ "$(printf '%s\n' "$cps" | grep -c .)" -ge 2 ] || tag=""
    fi
    [ -n "$tag" ] || tag="kit/$id/base"
  else
    tag="kit/$id/$to"
  fi
  git rev-parse -q --verify "refs/tags/$tag" >/dev/null || die "restore point $tag not found (see: kit-task points)"
  local backup; backup="backup/$id-$(date +%Y%m%d-%H%M%S)"
  if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    git stash push -u -q -m "kit-rollback $id $(now)" && warn "uncommitted work stashed (git stash list)"
  fi
  git branch "$backup" HEAD
  git reset -q --hard "$tag"
  local f; f="$(task_file "$id")"
  [ -f "$f" ] && log_progress "$f" "ROLLBACK to $tag (previous HEAD saved as $backup)"
  info "rolled back to $tag. Previous state kept in branch $backup"
}

task_base_commit() { # task_base_commit <id> <type> → commit the task branch started from (CI: KIT_BASE_REF=origin/<base>)
  if [ -n "${KIT_BASE_REF:-}" ]; then git merge-base HEAD "$KIT_BASE_REF" 2>/dev/null || true; return; fi
  git rev-parse -q --verify "refs/tags/kit/$1/base^{commit}" 2>/dev/null && return
  git merge-base HEAD "$(base_for_type "${2:-feature}")" 2>/dev/null || true
}

section_body() { # section_body <file> <heading-regex> → meaningful lines of that ## section (comments, blanks, table chrome removed)
  perl -0pe 's/<!--.*?-->//gs' "$1" | awk -v h="$2" '/^## /{ins = ($0 ~ h); next} ins' \
    | grep -vE '^[[:space:]]*$|^[[:space:]]*\|[-|: ]+\|[[:space:]]*$|^\|[[:space:]]*#[[:space:]]*\|[[:space:]]*Question' || true
}

unresolved_test_refs() { # unresolved_test_refs <docs/qa/TASK-NNN.md> → one line per test case whose "Automated in" does not resolve
  local qa="$1" tag tc ref file name
  awk -F'|' '/^\| *TC-[0-9]+/ {
      ref=$9; st=tolower($10); gsub(/^[ `]+|[ `]+$/, "", ref); gsub(/^ +| +$/, "", st)
      if (st ~ /manual/) next
      if (ref == "") { print "MISSING" "\t" $2; next }
      print "CHECK" "\t" $2 "\t" ref }' "$qa" |
  while IFS="$(printf '\t')" read -r tag tc ref; do
    if [ "$tag" = MISSING ]; then echo "$tc: no 'Automated in'"; continue; fi
    file="${ref%%::*}"; name=""
    if [ "${ref#*::}" != "$ref" ]; then name="${ref#*::}"; fi
    if [ ! -f "$KIT_ROOT/$file" ]; then echo "$tc: $file not found"
    elif [ -n "$name" ] && ! grep -qF -- "$name" "$KIT_ROOT/$file"; then echo "$tc: '$name' not in $file"; fi
  done
  return 0
}

cmd_verify() {
  local id="${1:-}"; [ -n "$id" ] || id="$(require_task_branch)"
  local f; f="$(task_file "$id")"; [ -f "$f" ] || die "task file for $id not found"
  local type change bad=0 ac qa
  type="$(fm_get "$f" type)"; change="$(fm_get "$f" change)"
  gate() { if [ "$1" = ok ]; then printf '  %s✓%s %s\n' "$c_grn" "$c_off" "$2"; else printf '  %s✗%s %s\n' "$c_red" "$c_off" "$2"; bad=1; fi; }
  echo "workflow gates for $id ($type)"
  local s1 s2 ticks open_box unanswered
  s1="$(section_body "$f" '^## 1\. Understand')"
  [ -n "$s1" ] && gate ok "1 Understand filled" || gate no "1 Understand is empty — restate the problem and link its source (change / UC / US)"
  case "$type" in
    feature|fix|hotfix|refactor)
      if [ -n "$change" ] || printf '%s\n' "$s1" | grep -qE '(UC|US|BR|FR)-[0-9]+|[Ss]ource:|openspec/specs/[a-z0-9]'; then gate ok "1 source linked (change / UC / US / BR / spec / Source:)"
      else gate no "1 Understand links no source — set 'change:' in the front matter, cite a UC/US/BR/FR id or an openspec/specs/<capability> link, or add 'Source: <issue / request, who, date>'"; fi ;;
  esac
  # 2 Clarify: the ambiguity checklist must be walked (every box ticked) and every asked question answered — "None" alone is not enough
  s2="$(section_body "$f" '^## 2\. Clarifications')"
  ticks="$(printf '%s\n' "$s2" | grep -cE '^[[:space:]]*- \[[xX]\]' || true)"
  open_box="$(printf '%s\n' "$s2" | grep -cE '^[[:space:]]*- \[ \]' || true)"
  if [ "${ticks:-0}" -ge 8 ] && [ "${open_box:-0}" -eq 0 ]; then gate ok "2 ambiguity checklist walked ($ticks/8)"
  else gate no "2 Clarifications: tick every item of the ambiguity checklist ($ticks ticked, $open_box open) — write n/a where it does not apply (template: .agent/tasks/_TEMPLATE.md)"; fi
  unanswered="$(printf '%s\n' "$s2" | sed 's/\\|/¦/g' | awk -F'|' '/^\|[[:space:]]*[0-9]+[[:space:]]*\|/ { q=$3; a=$4; gsub(/[[:space:]]/,"",q); gsub(/[[:space:]]/,"",a); n=$2; gsub(/[[:space:]]/,"",n); if (q!="" && a=="") printf " #%s", n }')"
  [ -z "$unanswered" ] && gate ok "2 every question answered" || gate no "2 questions without an answer:$unanswered — a blocking question stops the task (kit-handoff), never guess"
  [ -n "$(section_body "$f" '^## 3\. Solution')" ] && gate ok "3 Solution filled" || gate no "3 Solution is empty — approach, reuse found, files touched"
  # assumptions written by the agent must be confirmed by a human before the work is finished
  if [ -x "$KIT_DIR/scripts/kit-trace" ]; then
    local scope=("$f") asm
    [ -n "$change" ] && [ -d "$(change_dir "$change")" ] && scope+=("$(change_dir "$change")")
    # project-level BA / SA assumptions (scope, architecture) block every finish until a human confirms them
    local pdoc; for pdoc in docs/ba/BRIEF.md docs/architecture/SOLUTION.md; do [ -f "$KIT_ROOT/$pdoc" ] && scope+=("$KIT_ROOT/$pdoc"); done
    if asm="$("$KIT_DIR/scripts/kit-trace" assumptions "${scope[@]}" 2>&1)"; then gate ok "no unconfirmed ASSUMPTION in the task / change"
    else gate no "unconfirmed assumptions — the human answers each one; the answer is rewritten as 'CONFIRMED: <answer> (who, date)':
$(printf '%s\n' "$asm" | head -n 10 | sed 's/^/    /')"; fi
    if "$KIT_DIR/scripts/kit-trace" >/dev/null 2>&1; then gate ok "traceability: every UC/US/BR/FR/NFR/ADR id referenced exists"
    else gate no "traceability errors (ids referenced but not defined) — run: .agent/scripts/kit-trace"; fi
  fi
  ac="$(section_body "$f" '^## Acceptance criteria')"
  if printf '%s\n' "$ac" | grep -qE '^- \[[xX]\]' && ! printf '%s\n' "$ac" | grep -qE '^- \[ \]'; then gate ok "all acceptance criteria ticked"
  else gate no "acceptance criteria: every item must be ticked [x] (and proven by a test)"; fi
  case "$type" in
    feature|fix|hotfix|refactor)
      qa="$KIT_ROOT/docs/qa/$id.md"
      if [ -f "$qa" ]; then
        gate ok "test plan docs/qa/$id.md exists"
        local n missing=""
        for n in $(printf '%s\n' "$ac" | grep -oE '^- \[.\] AC[0-9]+' | grep -oE 'AC[0-9]+'); do grep -qw "$n" "$qa" || missing="$missing $n"; done
        [ -z "$missing" ] && gate ok "every AC appears in the test plan" || gate no "AC without test cases in docs/qa/$id.md:$missing"
        # every non-manual test case must point to a real test: `path` or `path::test name`
        local bad_ref; bad_ref="$(unresolved_test_refs "$qa")"
        [ -z "$bad_ref" ] && gate ok "every automated test case points to an existing test" \
          || gate no "test plan references that do not resolve (fill 'Automated in' as path::test-name, or Status 'manual' + reason):
$(printf '%s\n' "$bad_ref" | sed 's/^/      /' | head -n 10)"
      else gate no "missing docs/qa/$id.md — create it: .agent/scripts/kit-new testplan $id"; fi ;;
  esac
  local s7; s7="$(section_body "$f" '^## 7\. Result')"
  [ -n "$s7" ] && gate ok "7 Result filled" || gate no "7 Result is empty — what changed, how verified, docs updated"
  # living docs: a feature that changes code must change a spec / living doc in the same branch (or say why not)
  if [ "$type" = feature ]; then
    local base changed code docs
    base="$(task_base_commit "$id" "$type")"
    if [ -n "$base" ]; then
      changed="$( { git diff --name-only "$base" 2>/dev/null; git ls-files --others --exclude-standard; } | sort -u)"
      code="$(printf '%s\n' "$changed" | grep -vE "$PLANNING_RE"'|\.md$|(^|/)(tests?|__tests__|spec|e2e)/|\.(test|spec)\.[a-z]+$|_test\.[a-z]+$' | grep . || true)"
      # spec deltas count, an OpenSpec change's tasks.md / proposal.md checklist does not
      docs="$(printf '%s\n' "$changed" | grep -E '^(openspec/specs/|openspec/changes/[^/]+/(specs/|design\.md$)|docs/(api|architecture|data|platform|security)/|README\.md$)' || true)"
      if [ -z "$code" ] || [ -n "$docs" ] || printf '%s\n' "$s7" | grep -qiE '^[^a-z]*docs?:[[:space:]]*(none|n/?a|no |không)'; then gate ok "living docs updated with the code (or 'Docs: none — <why>' in §7)"
      else gate no "code changed but no spec / living doc did (openspec change, docs/api, docs/architecture, README) — update them, or write 'Docs: none — <why>' in §7"; fi
    fi
  fi
  if [ -n "$change" ] && has_openspec; then
    if [ -d "$(change_dir "$change")" ]; then
      if "$KIT_DIR/scripts/kit-openspec" validate "$change" --strict --no-interactive >/dev/null 2>&1; then gate ok "OpenSpec change '$change' valid (--strict)"
      else gate no "OpenSpec change '$change' invalid — run: .agent/scripts/kit-openspec validate $change --strict"; fi
    elif ls -d "$KIT_ROOT"/openspec/changes/archive/*-"$change" >/dev/null 2>&1; then gate ok "OpenSpec change '$change' already archived"
    else gate no "OpenSpec change '$change' not found"; fi
  fi
  [ $bad -eq 0 ] || return 1
  info "gates OK"
}

archive_change_if_last() { # archive_change_if_last <id> <task-file> — OpenSpec archive on the last task of a change
  local id="$1" f="$2" change p st open="" unchecked
  change="$(fm_get "$f" change)"
  [ -n "$change" ] && has_openspec && [ -d "$(change_dir "$change")" ] || return 0
  for p in $(tasks_of_change "$change"); do
    [ "$(basename "$p")" = "$(basename "$f")" ] && continue
    st="$(task_effective_status "$(task_view "$p")")"
    case "$st" in done|abandoned|review) ;; *) open="$open $(basename "$p" .md | grep -oE '^TASK-[0-9]+')" ;; esac
  done
  if [ -n "$open" ]; then info "OpenSpec change '$change' still has open tasks:$open — it is archived by the last one"; return 0; fi
  unchecked="$(grep -cE '^[[:space:]]*- \[ \]' "$(change_dir "$change")/tasks.md" 2>/dev/null || true)"
  [ "${unchecked:-0}" -eq 0 ] || die "openspec/changes/$change/tasks.md has $unchecked unticked item(s) — finish them or move them to a new task/change first"
  info "archiving OpenSpec change '$change' → openspec/specs (merged with this PR)"
  "$KIT_DIR/scripts/kit-openspec" archive "$change" -y >/dev/null || die "openspec archive failed — run: .agent/scripts/kit-openspec archive $change"
  log_progress "$f" "OpenSpec change $change archived into openspec/specs"
  git add -A "$KIT_ROOT/openspec" "$KIT_TASKS"
  git commit -q -m "docs($id): archive OpenSpec change $change into specs" || true
}

cmd_finish() {
  local id; id="$(require_task_branch)"
  require_clean
  cmd_verify "$id" || die "workflow gates not met — complete the task file (see above), checkpoint, then finish again"
  info "running quality gate: kit-run check"
  "$KIT_DIR/scripts/kit-run" check || die "checks failed — fix before finishing"
  local f type base br title
  f="$(task_file "$id")"; type="$(fm_get "$f" type)"; base="$(base_for_type "${type:-feature}")"
  archive_change_if_last "$id" "$f"
  br="$(current_branch)"; title="$(fm_get "$f" title)"
  fm_set "$f" status review
  log_progress "$f" "finished, PR to $base"
  git add -A "$KIT_TASKS"; git commit -q -m "chore($id): ready for review" || true
  if ! has_remote; then warn "no remote: merge manually → git checkout $base && git merge --no-ff $br"; return; fi
  git push -q -u "$(remote)" "$br"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    local body; body="$(mktemp)"
    local issue; issue="$(issue_of "$id" "$(cat "$f")")"
    { echo "Task: \`$id\` — $title"; echo; [ -n "$issue" ] && { echo "Closes #$issue"; echo; }; echo "Task file: \`${f#"$KIT_ROOT"/}\`"; echo
      sed -n '/^## Acceptance criteria/,/^## /p' "$f" | sed '$d'; echo
      cat "$KIT_ROOT/.github/PULL_REQUEST_TEMPLATE.md" 2>/dev/null; } > "$body"
    gh pr create --base "$base" --head "$br" --title "${type:-feature}($id): $title" --body-file "$body" || warn "gh pr create failed — open the PR manually"
    rm -f "$body"
  else
    warn "gh not available/authenticated — open a PR: $br → $base"
  fi
}

find_merge_commit() { # find_merge_commit <id>
  local id="$1" c
  c="$(git rev-parse -q --verify "refs/tags/kit/$id/merged" 2>/dev/null || true)"
  [ -n "$c" ] && { echo "$c"; return; }
  for b in "$(develop_branch)" "$(main_branch)"; do
    c="$(git log "$b" --first-parent --format=%H --grep="$id" -n1 2>/dev/null || true)"
    [ -n "$c" ] && { echo "$c"; return; }
  done
}

cmd_merged() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: kit-task merged TASK-NNN"
  has_remote && git fetch -q "$(remote)" 2>/dev/null || true
  local c; c="$(find_merge_commit "$id")"
  [ -n "$c" ] || die "no commit mentioning $id on $(develop_branch)/$(main_branch) first-parent history — is the PR merged and pulled?"
  git tag -f "kit/$id/merged" "$c" >/dev/null
  info "tagged kit/$id/merged → $(git log -1 --format='%h %s' "$c")"
}

cmd_revert() {
  local id="${1:-}"; [ -n "$id" ] || die "usage: kit-task revert TASK-NNN"
  require_clean
  local c; c="$(find_merge_commit "$id")"; [ -n "$c" ] || die "cannot find merge commit for $id (run: kit-task merged $id)"
  local base; base="$(develop_branch)"
  git checkout -q "$base"; has_remote && git pull -q --ff-only "$(remote)" "$base" 2>/dev/null || true
  local br="revert/$id-$(date +%Y%m%d%H%M)"
  git checkout -q -b "$br"
  if [ "$(git rev-list --parents -n1 "$c" | wc -w)" -gt 2 ]; then git revert --no-edit -m 1 "$c"; else git revert --no-edit "$c"; fi
  info "revert commit created on $br. Run checks, then push + PR to $base (kit-task finish is for TASK branches; use: git push -u origin $br)"
}

cmd_abandon() {
  local id; id="$(require_task_branch)"
  local br backup; br="$(current_branch)"; backup="backup/$id-abandoned-$(date +%Y%m%d-%H%M%S)"
  git add -A && git commit -q -m "chore($id): wip before abandon" 2>/dev/null || true
  git branch -m "$br" "$backup"
  git checkout -q "$(base_for_type "$(fm_get "$(task_file "$id")" type)")"
  info "abandoned. Work kept in $backup; task file on this branch is untouched (status unchanged)"
}

gh_ready() {
  command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) not installed"
  gh auth status >/dev/null 2>&1 || die "gh not authenticated — run: gh auth login"
}
issue_body() { # issue_body <task-content> <file-name>
  printf '%s\n' "$1" | awk '/^## Goal/{p=1} /^## (Context|Out of scope|Plan|Test cases|Risks|Progress log|Handoff)/{p=0} /^## Acceptance criteria/{p=1} p'
  printf '\n---\nTask file: `%s` · synced by agent-kit (edit the task file, not this issue body)\n' "$2"
}
ensure_labels() {
  local l
  for l in "status:todo:ededed" "status:in-progress:fbca04" "status:review:1d76db" "status:done:0e8a16" "status:abandoned:b60205" \
           "type:feature:a2eeef" "type:fix:d73a4a" "type:hotfix:b60205" "type:refactor:c5def5" "type:chore:ededed" "type:docs:0075ca" "type:test:bfd4f2" \
           "priority:P1:b60205" "priority:P2:fbca04" "priority:P3:c2e0c6"; do
    gh label create "${l%:*}" --color "${l##*:}" --force >/dev/null 2>&1 || true
  done
}

cmd_sync_gh() {
  gh_ready
  local sel="${1:---all}" name c id title st type prio issue body n url changed=0 proj
  proj="$(cfg gh_project)"
  ensure_labels
  for name in $(task_names_all); do
    id="$(basename "$name" | grep -oE '^TASK-[0-9]+')"
    [ "$sel" = --all ] || [ "$sel" = "$id" ] || continue
    c="$(task_view "$name")"; [ -n "$c" ] || continue
    title="$(fmv "$c" title)"; st="$(task_effective_status "$c")"; type="$(fmv "$c" type)"; prio="$(fmv "$c" priority)"; issue="$(issue_of "$id" "$c")"
    body="$(mktemp)"; issue_body "$c" "$name" > "$body"
    if [ -z "$issue" ]; then
      url="$(gh issue create --title "[$id] $title" --body-file "$body" --label "status:$st" --label "type:${type:-feature}" --label "priority:${prio:-P2}")" || { warn "$id: issue create failed"; rm -f "$body"; continue; }
      n="${url##*/}"
      issue_set "$id" "$n"; changed=1
      info "$id → created #$n"
      [ -n "$proj" ] && { gh project item-add "${proj#*/}" --owner "${proj%/*}" --url "$url" >/dev/null 2>&1 || warn "$id: could not add to project $proj"; }
    else
      n="$issue"
      gh issue edit "$n" --title "[$id] $title" --body-file "$body" --add-label "status:$st,type:${type:-feature},priority:${prio:-P2}" \
         --remove-label "$(printf 'status:%s,' todo in-progress review done abandoned | sed "s/status:$st,//; s/,$//")" >/dev/null 2>&1 || warn "$id: issue edit #$n failed"
      case "$st" in
        done|abandoned) gh issue close "$n" --reason "$( [ "$st" = done ] && echo completed || echo 'not planned')" >/dev/null 2>&1 || true ;;
        *) [ "$(gh issue view "$n" --json state -q .state 2>/dev/null)" = CLOSED ] && gh issue reopen "$n" >/dev/null 2>&1 || true ;;
      esac
      info "$id → #$n [$st]"
    fi
    rm -f "$body"
  done
  [ $changed -eq 0 ] || warn "new issue links saved in .agent/tasks/.issues — commit that file (it is never edited on task branches, so no merge conflicts)"
}

cmd_pull_gh() {
  gh_ready
  local n="${1:-}"; n="${n#\#}"; [ -n "$n" ] || die "usage: kit-task pull-gh <issue-number>"
  local existing; existing="$(sed -n "s/=$n\$//p" "$ISSUE_MAP" 2>/dev/null | head -n1)"
  [ -n "$existing" ] || existing="$(grep -l "^issue: $n\$" "$KIT_TASKS"/TASK-*.md 2>/dev/null | head -n1 || true)"
  [ -z "$existing" ] || die "issue #$n is already linked to $(basename "$existing")"
  local title body labels type=feature prio=P2 id f
  title="$(gh issue view "$n" --json title -q .title)" || die "cannot read issue #$n"
  body="$(gh issue view "$n" --json body -q .body)"
  labels="$(gh issue view "$n" --json labels -q '.labels[].name' | tr '\n' ' ')"
  case " $labels " in *" bug "*|*"type:fix"*) type=fix ;; *"type:hotfix"*) type=hotfix ;; *"type:chore"*) type=chore ;; *"type:docs"*) type=docs ;; *"type:refactor"*) type=refactor ;; esac
  case " $labels " in *"priority:P1"*) prio=P1 ;; *"priority:P3"*) prio=P3 ;; esac
  id="$(cmd_new "$title" --type "$type" --priority "$prio" | tail -n1)"
  f="$(task_file "$id")"; fm_set "$f" issue "$n"; issue_set "$id" "$n"
  awk -v b="$body" -v n="$n" '{print} /^## Context/{print "From GitHub issue #" n ":"; print ""; print b}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  info "$id created from #$n — refine Goal/Acceptance criteria (kit-plan) before starting"
}

cmd_status() {
  local id br; br="$(current_branch)"; id="$(task_from_branch)"
  echo "branch : $br$(is_protected "$br" && echo '  (protected — do not commit here)')"
  if [ -n "$id" ]; then
    local f; f="$(task_file "$id")"
    echo "task   : $id — $(fm_get "$f" title) [$(fm_get "$f" status)]"
    echo "points : $(git tag -l "kit/$id/*" | tr '\n' ' ')"
    echo "ahead  : $(git rev-list --count "kit/$id/base..HEAD" 2>/dev/null || echo '?') commit(s) since base"
  fi
  echo "dirty  : $(git status --porcelain | wc -l | tr -d ' ') file(s)"
}

cmd_list() {
  printf '%-9s %-12s %-4s %-6s %s\n' ID STATUS PRIO ISSUE TITLE
  local name c
  for name in $(task_names_all); do
    c="$(task_view "$name")"; [ -n "$c" ] || continue
    printf '%-9s %-12s %-4s %-6s %s\n' "$(fmv "$c" id)" "$(task_effective_status "$c")" "$(fmv "$c" priority)" "$(issue_of "$(fmv "$c" id)" "$c" | sed 's/^./#&/')" "$(fmv "$c" title)"
  done
}

sub="${1:-status}"; shift || true
case "$sub" in
  new|start|checkpoint|points|rollback|finish|merged|revert|abandon|status|list|worktrees|cleanup|verify) "cmd_$sub" "$@" ;;
  sync-gh) cmd_sync_gh "$@" ;;
  pull-gh) cmd_pull_gh "$@" ;;
  *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
