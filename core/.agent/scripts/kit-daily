#!/usr/bin/env bash
# kit-daily [YYYY-MM-DD]   create/refresh docs/daily/<YYYY-MM>/<date>.md (auto section regenerated, notes kept)
# kit-daily --week         write a weekly roll-up of the last 7 days
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"

auto_tasks() {
  local d="$1" f st
  echo "| ID | Status | Prio | Title | Branch |"
  echo "|---|---|---|---|---|"
  for f in "$KIT_TASKS"/TASK-*.md; do
    [ -f "$f" ] || continue
    st="$(fm_get "$f" status)"
    if [ "$st" = "done" ] && [ "$(fm_get "$f" "done")" != "$d" ]; then continue; fi
    printf '| %s | %s | %s | %s | `%s` |\n' "$(fm_get "$f" id)" "$st" "$(fm_get "$f" priority)" "$(fm_get "$f" title)" "$(fm_get "$f" branch)"
  done
}

auto_commits() { # auto_commits <since> <until>
  local out
  out="$(git log --all --source --no-merges --since="$1" --until="$2" \
        --date=format:'%m-%d %H:%M' --format='- `%h` %ad %an — %s  _(%S)_' 2>/dev/null | grep -v 'refs/stash' || true)"
  echo "${out:-_(no commits)_}"
}

auto_block() { # auto_block <date>
  local d="$1"
  echo "<!-- AUTO:BEGIN — regenerated by kit-daily, edits inside are overwritten -->"
  echo "_Generated $(now) · branch \`$(current_branch)\`_"
  echo
  echo "### Commits"
  auto_commits "$d 00:00" "$d 23:59:59"
  echo
  echo "### Tasks (open + done today)"
  auto_tasks "$d"
  echo
  echo "### Restore points created today"
  git for-each-ref --format='%(refname:short) %(creatordate:short)' refs/tags/kit/ 2>/dev/null | awk -v d="$d" '$2==d{print "- `"$1"`"}' | grep . || echo "_(none)_"
  echo "<!-- AUTO:END -->"
}

write_daily() {
  local d="$1" dir f
  dir="$KIT_ROOT/docs/daily/${d:0:7}"; f="$dir/$d.md"; mkdir -p "$dir"
  if [ ! -f "$f" ]; then
    sed "s/{{DATE}}/$d/g" "$KIT_ROOT/docs/daily/_TEMPLATE.md" > "$f"
  fi
  local blk; blk="$(mktemp)"; auto_block "$d" > "$blk"
  awk -v blk="$blk" '
    /<!-- AUTO:BEGIN/ {while((getline l < blk)>0) print l; skip=1; next}
    /<!-- AUTO:END -->/ {skip=0; next}
    !skip {print}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  rm -f "$blk"
  local idx="$KIT_ROOT/docs/daily/README.md" rel="${d:0:7}/$d.md"
  grep -qF "($rel)" "$idx" 2>/dev/null || echo "- [$d]($rel)" >> "$idx"
  info "daily report: ${f#"$KIT_ROOT"/}"
}

write_week() {
  local end start wk dir f
  end="$(today)"
  start="$(date -d "$end -6 days" +%Y-%m-%d 2>/dev/null || date -v-6d +%Y-%m-%d)"
  wk="$(date +%G-W%V)"; dir="$KIT_ROOT/docs/daily/${end:0:7}"; mkdir -p "$dir"; f="$dir/week-$wk.md"
  {
    echo "# Weekly roll-up $wk ($start → $end)"
    echo
    echo "## Summary"
    echo "_Agent/human: 5 bullets max — outcomes, not activity._"
    echo
    echo "## Tasks done this week"
    local t
    for t in "$KIT_TASKS"/TASK-*.md; do
      [ -f "$t" ] || continue
      local dd; dd="$(fm_get "$t" "done")"
      [ -n "$dd" ] && [[ ! "$dd" < "$start" ]] && echo "- $(fm_get "$t" id) — $(fm_get "$t" title) ($dd)"
    done
    echo
    echo "## Daily reports"
    for p in "$KIT_ROOT"/docs/daily/*/20*.md; do
      [ -f "$p" ] || continue
      b="$(basename "$p" .md)"; [[ "$b" < "$start" ]] || [[ "$b" > "$end" ]] || echo "- [$b](../${p#"$KIT_ROOT"/docs/daily/})"
    done
    echo
    echo "## Commits"
    auto_commits "$start 00:00" "$end 23:59:59"
  } > "$f"
  info "weekly roll-up: ${f#"$KIT_ROOT"/}"
}

case "${1:-}" in
  --week) write_week ;;
  "") write_daily "$(today)" ;;
  *) [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "usage: kit-daily [YYYY-MM-DD|--week]"; write_daily "$1" ;;
esac
