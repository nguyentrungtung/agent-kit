#!/usr/bin/env bash
# kit-adopt-scan [--out <file>] — inventory of an EXISTING repo that just got the kit, for the kit-migrate playbook.
# Read-only: it changes nothing. Prints Markdown (and writes it to --out, default .agent/local/adopt-scan.md — gitignored,
# because it names files that may hold secrets). Sections:
#   1 old agent instructions (AGENTS.md of your own, agent/, .cursor/rules, …)   2 links into them (break when they are deleted)
#   3 docs/ folders: kit slots vs your own, heavy/binary files                    4 before sharing: secret-looking content, personal-data files
#   5 .gitignore lines that hide kit or old files                                  6 *.kit-new / *.bak-kit left to merge
#   7 CI: two pipelines side by side                                               8 checks your CI / hooks run that no cmd_* covers
#   9 gates left empty in .agent/project.yaml
# Values are never printed: a secret-looking line shows file:line and the key name only.
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"

out=".agent/local/adopt-scan.md"
while [ $# -gt 0 ]; do case "$1" in --out) out="${2:?--out needs a file}"; shift 2 ;; -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; *) die "unknown option $1" ;; esac; done

PRUNE='-name .git -o -name node_modules -o -name .venv -o -name venv -o -name dbt_packages -o -name target -o -name vendor -o -name .agent -o -name .agents'
lines() { wc -l < "$1" 2>/dev/null | tr -d ' '; }
state() { # tracked | ignored | untracked
  if git ls-files --error-unmatch -- "$1" >/dev/null 2>&1 || [ -n "$(git ls-files -- "$1" 2>/dev/null | head -n1)" ]; then echo tracked
  elif git check-ignore -q -- "$1" 2>/dev/null; then echo "**ignored**"
  else echo untracked; fi
}
in_manifest() { [ -f .agent/kit.manifest ] && awk '{print $2}' .agent/kit.manifest | grep -qxF "$1"; }
sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1; else sha256sum "$1" | cut -d' ' -f1; fi; }
kit_unchanged() { [ -f .agent/kit.manifest ] && [ "$(awk -v p="$1" '$2 == p {print $1}' .agent/kit.manifest | head -n1)" = "$(sha "$1")" ]; }
own_commands() { # every command the repo's own CI and hooks run (one per line)
  local f
  [ -f .gitlab-ci.yml ] && sed -n 's/^[[:space:]]*-[[:space:]]\{1,\}//p' .gitlab-ci.yml
  for f in .github/workflows/*.yml .github/workflows/*.yaml; do [ -f "$f" ] && ! in_manifest "$f" && sed -n 's/^[[:space:]]*run:[[:space:]]*//p' "$f"; done
  [ -f .pre-commit-config.yaml ] && sed -n 's/^[[:space:]]*entry:[[:space:]]*//p' .pre-commit-config.yaml
  return 0
}
own_uncovered() { # keep the commands that run a file of this repo (tools/checks/x.py, scripts/y.sh…) no cmd_* mentions
  local c t
  set -f
  while IFS= read -r c; do
    for t in $c; do
      t="${t#./}"
      case "$t" in
        */*.py|*/*.sh|*/*.js|*/*.ts|*/*.rb)
          [ -f "$t" ] || continue
          grep -qF -- "$t" "$KIT_CFG" 2>/dev/null || echo "- \`$t\` — run by your CI or hooks (see the command there; it is not printed here, it may carry tokens)"
          break ;;
      esac
    done
  done
  set +f
}

report() {
echo "# Adoption scan — $(cfg name "$(basename "$KIT_ROOT")") · $(date +%Y-%m-%d)"
echo
echo "Generated by \`.agent/scripts/kit-adopt-scan\` for the **kit-migrate** playbook. Nothing was changed."

# ---------------------------------------------------------------- 1. old agent instructions
echo; echo "## 1. Old agent instructions"; echo
LEGACY_DIRS=""
rows=""
for f in AGENTS.md CLAUDE.md GEMINI.md .cursorrules .windsurfrules .github/copilot-instructions.md; do
  [ -f "$f" ] || continue
  kit_unchanged "$f" && continue   # the kit's own file, untouched
  case "$f" in
    AGENTS.md) grep -q 'kit:playbooks:start' "$f" && continue; note="your own — the kit's version is in AGENTS.md.kit-new" ;;
    CLAUDE.md) [ "$(tr -d '[:space:]' < "$f")" = "@AGENTS.md" ] && continue; note="should become just @AGENTS.md" ;;
    *) note="harness-specific copy — AGENTS.md is the single source" ;;
  esac
  rows="$rows| \`$f\` | $(lines "$f") | $(state "$f") | $note |
"
done
for d in agent agents .ai ai-rules .cursor/rules .clinerules .windsurf/rules docs/agents .claude/commands; do
  [ -d "$d" ] || continue
  n=0; l=0
  while IFS= read -r f; do in_manifest "$f" && continue; n=$((n+1)); l=$((l+$(lines "$f"))); done < <(find "$d" -type f 2>/dev/null)
  [ $n -gt 0 ] || continue
  LEGACY_DIRS="$LEGACY_DIRS $d"
  rows="$rows| \`$d/\` | $l ($n files) | $(state "$d") | rules / context to move into .agent/ |
"
done
if [ -n "$rows" ]; then echo "| Path | Lines | Git | Note |"; echo "|---|---|---|---|"; printf '%s' "$rows"
else echo "None found."; fi
for d in $LEGACY_DIRS; do
  echo; echo "\`$d/\`:"
  find "$d" -type f 2>/dev/null | sort | while IFS= read -r f; do in_manifest "$f" || echo "- \`$f\` ($(lines "$f") lines)"; done
done

# ---------------------------------------------------------------- 2. links into old files
echo; echo "## 2. References to old files (fix before deleting them)"; echo
refs=""
for d in $LEGACY_DIRS; do
  re="(^|[^A-Za-z0-9_.-])${d//./\\.}/[A-Za-z0-9_./-]+"
  refs="$refs$(grep -rnoE --include='*.md' --include='*.mdc' --include='*.yaml' --include='*.yml' --include='*.json' --include='*.toml' --include='*.py' --include='*.sh' \
       --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=.venv --exclude-dir=.agent --exclude-dir=.agents --exclude-dir="$d" -- "$re" . 2>/dev/null \
       | sed -E "s#^\./##; s#:([0-9]+):[^A-Za-z0-9_.-]?#:\1 → #" || true)
"
done
refs="$(printf '%s' "$refs" | awk 'NF' | sort -u)"
if [ -n "$refs" ]; then printf '%s\n' "$refs" | head -n 80 | sed 's/^/- /'; else echo "None."; fi

# ---------------------------------------------------------------- 3. docs/
echo; echo "## 3. docs/"; echo
if [ -d docs ]; then
  echo "| Folder | Files | Size | Owner |"; echo "|---|---|---|---|"
  for d in docs/*/; do
    [ -d "$d" ] || continue; d="${d%/}"; n="$(find "$d" -type f | wc -l | tr -d ' ')"; sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
    case "${d#docs/}" in ba|architecture|api|platform|data|adr|plan|qa|security|daily) o="kit slot" ;; *) o="yours — keep, link from docs/README.md" ;; esac
    echo "| \`$d/\` | $n | $sz | $o |"
  done
  heavy="$(find docs -type f \( -size +1024k -o -iname '*.xlsx' -o -iname '*.xls' -o -iname '*.csv' -o -iname '*.pdf' -o -iname '*.docx' -o -iname '*.pptx' -o -iname '*.zip' \) 2>/dev/null | sort | head -n 40)"
  if [ -n "$heavy" ]; then echo; echo "Binary / heavy files (Git keeps every version forever — commit only what the team needs; check personal data):"
    printf '%s\n' "$heavy" | while IFS= read -r f; do echo "- \`$f\` ($(du -h "$f" | cut -f1))"; done; fi
else echo "No docs/ folder."; fi

# ---------------------------------------------------------------- 4. sensitive content
echo; echo "## 4. Before sharing: secret-looking content and personal data (values hidden)"; echo
scan_paths=""; for p in docs $LEGACY_DIRS AGENTS.md; do [ -e "$p" ] && scan_paths="$scan_paths $p"; done
hits=""
if [ -n "$scan_paths" ]; then
  # file names that are secrets by nature, or exports that usually carry tokens (Postman, HAR)
  hits="$(find $scan_paths -type f 2>/dev/null | grep -Ei '(^|/)\.env(\.[^/]*)?$|\.(pem|key|p12|pfx|jks|keystore|har)$|(^|/)id_(rsa|ed25519)|credential|service-account.*\.json$|postman.*\.json$|\.postman_(collection|environment)' \
         | grep -Ev '\.env\.(example|sample|template)$' \
         | while IFS= read -r f; do if git check-ignore -q -- "$f" 2>/dev/null; then echo "$f — file type, already kept out of Git (ok)"; else echo "$f — file type"; fi; done || true)"
  hits="$hits
$(grep -rnHIiE --exclude-dir=.git -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{10,}|[a-z][a-z0-9+.-]*://[^/[:space:]:@]+:[^/[:space:]@]{3,}@|(^|[^A-Za-z.])(api[_-]?key|secret|passw(or)?d|token|client[_-]?secret|access[_-]?key)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_.=-]{8,}' $scan_paths 2>/dev/null \
    | grep -viE '(example|changeme|placeholder|<[a-z_]+>|\$\{|xxxx|\*\*\*)' \
    | awk -F: '{ l=tolower($0); k="secret-like value"; if (l ~ /private key/) k="private key"; else if (l ~ /akia/) k="AWS key"; else if (l ~ /eyj/) k="JWT";
                 else if (l ~ /:\/\/[^\/]*:[^\/]*@/) k="password in URL"; else if (match(l, /(api[_-]?key|client[_-]?secret|access[_-]?key|secret|passw(or)?d|token)/)) k=substr(l, RSTART, RLENGTH);
                 print $1 ":" $2 " — " k }' | sort -u | head -n 60 || true)"
  # personal data in samples (API responses pasted into docs): a person's name, phone, e-mail, national id, birth date, address with a value.
  # -H: the file name is always printed (GNU grep omits it for a single file, and the value would then show); only key names are reported.
  hits="$hits
$(grep -rnHIiE --exclude-dir=.git -- '(^|[^a-z0-9_])["'"'"']?(applicant_?name|full_?name|first_?name|last_?name|[a-z_]*_full_?name|ho_?ten|ho_va_ten|ten_cong_dan|ten_nguoi[a-z_]*|nguoi_nop|phone|phone_?number|mobile|so_dien_thoai|sdt|e_?mail|cccd|cmnd|so_dinh_danh_ca_nhan|ngay_sinh|dob|date_of_birth|dia_chi_thuong_tru|home_address)["'"'"']?[[:space:]]*[:=]' $scan_paths 2>/dev/null \
    | awk '{ f = $0; sub(/:.*/, "", f); r = substr($0, length(f) + 2); n = r; sub(/:.*/, "", n); c = tolower(substr(r, length(n) + 2))
        if (!match(c, /(applicant_?name|full_?name|first_?name|last_?name|[a-z_]*_full_?name|ho_?ten|ho_va_ten|ten_cong_dan|ten_nguoi[a-z_]*|nguoi_nop|phone_?number|phone|mobile|so_dien_thoai|sdt|e_?mail|cccd|cmnd|so_dinh_danh_ca_nhan|ngay_sinh|dob|date_of_birth|dia_chi_thuong_tru|home_address)/)) next
        k = substr(c, RSTART, RLENGTH); v = substr(c, RSTART + RLENGTH); sub(/^["\047]?[[:space:]]*[:=][[:space:]]*/, "", v); gsub(/["\047,]/, "", v); sub(/[[:space:]]+$/, "", v)
        if (length(v) < 3 || v ~ /^(null|none|true|false|string|text|varchar|character varying|<.*>|\{.*\}|\$.*)$/) next
        if (v ~ /(ẩn danh|an danh|anonym|example|placeholder|xxx|nguyen van a|john doe|\*\*\*)/) next
        print f ":" n " — personal data (" k ")" }' | sort -u | head -n 60 || true)"
  if command -v gitleaks >/dev/null 2>&1; then
    tmp="$(mktemp)"
    for p in $scan_paths; do gitleaks detect --no-git --no-banner --redact --exit-code 0 --source "$p" --report-format json --report-path "$tmp" >/dev/null 2>&1 || true
      [ -s "$tmp" ] && hits="$hits
$(jq -r '.[] | "\(.File):\(.StartLine) — gitleaks \(.RuleID)"' "$tmp" 2>/dev/null | sed "s#^\./##" | head -n 40)"; done
    rm -f "$tmp"
  fi
fi
hits="$(printf '%s\n' "$hits" | awk 'NF && !seen[$0]++')"
if [ -n "$hits" ]; then printf '%s\n' "$hits" | sed -e '/(ok)$/s/^/- /' -e '/(ok)$/!s/^/- [ ] /'; echo; echo "Each one: remove the value (keep the name, point to .env.example), replace a real person by an anonymous placeholder, or keep the file out of Git — BEFORE the .gitignore lines in §5 go (a push keeps the history)."
else echo "Nothing found by the built-in patterns$(command -v gitleaks >/dev/null 2>&1 && echo ' or gitleaks'). Still skim spreadsheets / exports in §3 for personal data."; fi

# ---------------------------------------------------------------- 5. .gitignore lines hiding kit / old files
echo; echo "## 5. .gitignore lines that hide kit or old files"; echo
probe="AGENTS.md CLAUDE.md .claude/settings.json .claude/skills .agent/project.yaml .agents/skills docs/README.md docs/adr/README.md openspec/project.md $LEGACY_DIRS"
gi="$(for p in $probe; do git check-ignore -v --no-index -- "$p" 2>/dev/null || true; done | awk -F'\t' '{ split($1, a, ":"); if (a[3] ~ /^!/) next; k=a[1] ":" a[2] " `" a[3] "`"; m[k]=m[k] " " $2 } END { for (k in m) print "- " k " → hides" m[k] }' | sort)"
if [ -n "$gi" ]; then printf '%s\n' "$gi"; echo; echo "To share them with the team, delete those lines — after §4 is clean."; else echo "None."; fi

# ---------------------------------------------------------------- 6. files to merge
echo; echo "## 6. Files left to merge"; echo
m="$(find . \( $PRUNE \) -prune -o -type f \( -name '*.kit-new' -o -name '*.bak-kit' \) -print 2>/dev/null | sed 's#^\./##' | sort)"
if [ -n "$m" ]; then printf '%s\n' "$m" | sed 's/^/- `/; s/$/`/'; echo; echo "Merge each \`X.kit-new\` into \`X\`, then delete it (they are never committed). \`*.bak-kit\` are backups of merged settings."
else echo "None."; fi

# ---------------------------------------------------------------- 7. CI
echo; echo "## 7. CI"; echo
ci=0
if [ -f .gitlab-ci.yml ] && [ -f .gitlab-ci.kit.yml ]; then ci=1
  if grep -q 'gitlab-ci.kit.yml' .gitlab-ci.yml; then echo "- \`.gitlab-ci.yml\` includes \`.gitlab-ci.kit.yml\` ✓"
  else echo "- [ ] \`.gitlab-ci.kit.yml\` is NOT included by \`.gitlab-ci.yml\` — the kit's gates do not run. Add \`include: [{ local: .gitlab-ci.kit.yml }]\`, then remove jobs the two files now run twice (e.g. ruff in both)."; fi
fi
if [ -f .gitlab-ci.yml ] && [ -d .github/workflows ]; then ci=1; echo "- [ ] both \`.gitlab-ci.yml\` and \`.github/workflows/\` — keep the one of your Git host ($(git_provider))"; fi
[ $ci -eq 1 ] || echo "One pipeline — nothing to merge."

# ---------------------------------------------------------------- 8. own checks not covered by cmd_*
echo; echo "## 8. Checks your CI / hooks run that no cmd_* covers"; echo
own="$(own_commands | own_uncovered | awk '!seen[$0]++')"
if [ -n "$own" ]; then printf '%s\n' "$own"; echo; echo "Add each to the cmd_* it belongs to (usually cmd_lint) so agents run it before every checkpoint."
else echo "None."; fi

# ---------------------------------------------------------------- 9. empty gates
echo; echo "## 9. Gates left empty"; echo
empty=""; for s in format_check lint typecheck arch test build audit; do [ -n "$(cfg "cmd_$s")" ] || empty="$empty cmd_$s"; done
if [ -n "$empty" ]; then echo "-$empty — each one: the repo does not use that tool yet (kit init said why). Decide: adopt it (add the tool, then set the command) or record it as baseline debt."
else echo "Every gate has a command."; fi
}

mkdir -p "$(dirname "$out")"
report | tee "$out"
echo >&2; info "written to $out"
