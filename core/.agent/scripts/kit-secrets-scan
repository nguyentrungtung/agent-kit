#!/usr/bin/env bash
# kit-secrets-scan [--staged | --all | --range <a..b>]
# Blocks: forbidden files (.env, keys, certs, credentials) and secret-looking content.
# Uses gitleaks when installed; always runs the built-in file + pattern checks too.
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"

mode="${1:---staged}"; range="${2:-}"

case "$mode" in
  --staged) files="$(git diff --cached --name-only --diff-filter=ACMR)" ;;
  --all)    files="$(git ls-files)" ;;
  --range)  [ -n "$range" ] || die "--range needs <a..b>"; files="$(git diff --name-only --diff-filter=ACMR "$range")" ;;
  *) die "usage: kit-secrets-scan [--staged|--all|--range a..b]" ;;
esac

# Paths that must never be committed. Override/extend with secrets_forbidden_extra in project.yaml
forbidden='(^|/)\.env$|(^|/)\.env\.[^/]*$|\.pem$|\.key$|\.p12$|\.pfx$|\.jks$|\.keystore$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$|(^|/)credentials(\.json)?$|(^|/)\.npmrc$|(^|/)\.pypirc$|(^|/)secrets?/|service-account.*\.json$|\.tfstate$'
allowed='\.env\.(example|sample|template|dist)$|\.example$'
extra="$(cfg secrets_forbidden_extra)"; [ -n "$extra" ] && forbidden="$forbidden|$extra"

bad=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if echo "$f" | grep -Eq "$forbidden" && ! echo "$f" | grep -Eq "$allowed"; then
    printf '%s[secret-file]%s %s\n' "$c_red" "$c_off" "$f"; bad=1
  fi
done <<< "$files"

# Content patterns (high-signal only, to keep false positives low)
patterns=(
  'AKIA[0-9A-Z]{16}'                                   # AWS access key
  '-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----'             # private keys
  'gh[pousr]_[A-Za-z0-9]{36,}'                         # GitHub tokens
  'xox[baprs]-[A-Za-z0-9-]{10,}'                       # Slack tokens
  'sk-(ant-|proj-)?[A-Za-z0-9_-]{20,}'                 # OpenAI/Anthropic-style keys
  'AIza[0-9A-Za-z_-]{35}'                              # Google API key
  '(postgres|mysql|mongodb(\+srv)?|redis|amqp)://[^:/ ]+:[^@/ ]{3,}@'  # DSN with password
  '(?i)(password|passwd|secret|api[_-]?key|access[_-]?token|client[_-]?secret)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'$\{ ]{8,}["'"'"']'
)
ignore_re="$(cfg secrets_ignore_paths '(^|/)(docs/|.*test.*fixtures?/|.*\.lock$|package-lock\.json$)')"

while IFS= read -r f; do
  [ -z "$f" ] || [ ! -f "$f" ] && continue
  echo "$f" | grep -Eq "$ignore_re" && continue
  grep -Iq . "$f" 2>/dev/null || continue           # skip binary
  if [ "$mode" = --staged ]; then content="$(git show ":$f" 2>/dev/null || true)"; else content="$(cat "$f")"; fi
  for p in "${patterns[@]}"; do
    # perl regex: portable on macOS (BSD grep has no -P)
    line="$(printf '%s\n' "$content" | P="$p" perl -ne 'BEGIN{$re=qr/$ENV{P}/} if(/$re/ && !/kit:allow-secret/){print "$.\n"; exit}')"
    if [ -n "$line" ]; then
      printf '%s[secret]%s %s:%s matches /%s/\n' "$c_red" "$c_off" "$f" "$line" "${p:0:40}"
      bad=1
    fi
  done
done <<< "$files"

if command -v gitleaks >/dev/null 2>&1; then
  if [ "$mode" = --staged ]; then gitleaks protect --staged --no-banner --redact || bad=1
  else gitleaks detect --no-banner --redact --no-git --source . || bad=1; fi
fi

if [ "$bad" -ne 0 ]; then
  cat >&2 <<'EOF'

Secrets / forbidden files detected. Do NOT commit them.
  - Move real values to .env (git-ignored) and document keys in .env.example
  - If it is a false positive, append the comment  kit:allow-secret  on that line
EOF
  exit 1
fi
info "secrets scan clean ($mode)"
