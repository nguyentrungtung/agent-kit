#!/usr/bin/env bash
# kit-new <kind> … — create documents from the templates in .agent/templates (never let an agent invent the skeleton)
#   kit-new task "<title>" [--type …] [--priority …]                  → .agent/tasks/TASK-NNN-slug.md (kit-task new)
#   kit-new testplan TASK-NNN                                          → docs/qa/TASK-NNN.md, one row per acceptance criterion
#   kit-new adr "<title>" [--task TASK-NNN]                            → docs/adr/NNNN-slug.md + index in DECISIONS.md
#   kit-new module <name> [--style layered|modular] [--component <path>]  → folders of one module per the architecture skeleton
#   kit-new doc <path.md> "<title>"                                    → living document with front matter
# Prints the created path. Never overwrites an existing file.
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"
TPL="$KIT_DIR/templates"

usage() {
  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
  local p
  for p in "$KIT_DIR"/plugins/*/new-*.sh; do
    [ -f "$p" ] && sed -n 's/^# //p' "$p" | head -n1
  done
  echo "Prints the created path. Never overwrites an existing file."
  exit 1
}
slug() { ascii_slug "$1" 50; }
esc() { printf '%s' "$1" | sed 's/[\/&|]/\\&/g'; }
next_num() { # next_num <dir> <prefix-regex> <width>  → zero-padded next number
  local n; n="$(ls "$1" 2>/dev/null | grep -oE "^$2[0-9]+" | grep -oE '[0-9]+$' | sed 's/^0*//' | sort -n | tail -n1)"
  printf "%0${3}d" $(( ${n:-0} + 1 ))
}
render() { # render <template> <dest> <key=value>...
  local t="$1" d="$2"; shift 2
  [ -f "$t" ] || die "template $(basename "$t") not found in .agent/templates (module not installed?)"
  [ -e "$d" ] && die "$d already exists"
  mkdir -p "$(dirname "$d")"
  local args=() kv
  for kv in "$@"; do args+=(-e "s|{{${kv%%=*}}}|$(esc "${kv#*=}")|g"); done
  sed "${args[@]}" "$t" > "$d"
  echo "${d#"$KIT_ROOT"/}"
}

kind="${1:-}"; shift || true
case "$kind" in
  task) exec "$KIT_DIR/scripts/kit-task" new "$@" ;;

  testplan)
    id="${1:-}"; [ -n "$id" ] || id="$(task_from_branch)"; [ -n "$id" ] || die "usage: kit-new testplan TASK-NNN"
    f="$(task_file "$id")"; [ -f "$f" ] || die "task $id not found"
    rows="$(mktemp)"
    sed -n '/^## Acceptance criteria/,/^## [^A]/p' "$f" | grep -E '^- \[.\] AC[0-9]+' | sed -E 's/^- \[.\] //' | awk '
      { ac = $1; txt = $0; sub(/^AC[0-9]+[[:space:]]*/, "", txt); sub(/^(—|-|:)[[:space:]]*/, "", txt); gsub(/\|/, "/", txt); n++
        printf "| TC-%02d | %s — %s | positive | unit | | | | | todo |\n", n, ac, txt }' > "$rows"
    [ -s "$rows" ] || echo "| TC-01 | AC1 | positive | unit | | | | | todo |" > "$rows"
    out="$(render "$TPL/testplan.md" "$KIT_ROOT/docs/qa/$id.md" ID="$id" TITLE="$(fm_get "$f" title)" CHANGE="$(fm_get "$f" change)" DATE="$(today)")"
    awk -v rf="$rows" '$0 == "{{ROWS}}" { while ((getline l < rf) > 0) print l; next } { print }' "$KIT_ROOT/$out" > "$KIT_ROOT/$out.tmp" \
      && mv "$KIT_ROOT/$out.tmp" "$KIT_ROOT/$out"; rm -f "$rows"
    echo "$out"
    ;;

  adr)
    title=""; task="$(task_from_branch)"
    while [ $# -gt 0 ]; do case "$1" in --task) task="$2"; shift 2 ;; *) title="${title:+$title }$1"; shift ;; esac; done
    [ -n "$title" ] || die 'usage: kit-new adr "<title>" [--task TASK-NNN]'
    num="$(next_num docs/adr '' 4)"
    out="$(render "$TPL/adr.md" "$KIT_ROOT/docs/adr/$num-$(slug "$title").md" NUM="$num" TITLE="$title" DATE="$(today)" TASK="${task:-}")"
    [ -f "$KIT_DIR/memory/DECISIONS.md" ] && printf '| ADR-%s | %s | %s | proposed | %s |\n' "$num" "$(today)" "$title" "$out" >> "$KIT_DIR/memory/DECISIONS.md"
    echo "$out"
    ;;

  module)
    name=""; style="$(cfg arch_style modular)"; comp=""
    while [ $# -gt 0 ]; do case "$1" in --style) style="$2"; shift 2 ;; --component) comp="$2"; shift 2 ;; *) name="$1"; shift ;; esac; done
    [ -n "$name" ] || die 'usage: kit-new module <name> [--style layered|modular] [--component <path>]'
    # component → stack (first component by default)
    entry=""; for e in $(cfg components ".=$(cfg stack)+"); do
      p="${e%%=*}"; if [ -z "$comp" ] || [ "$p" = "$comp" ] || [ "$p" = "${comp%/}" ]; then entry="$e"; break; fi; done
    [ -n "$entry" ] || die "component '$comp' not found in project.yaml components"
    cpath="${entry%%=*}"; rest="${entry#*=}"; stack="${rest%%+*}"; fw=""; [ "${rest#*+}" != "$rest" ] && fw="${rest#*+}"
    skel="$KIT_DIR/stack/$stack/skeletons/$style.txt"   # a framework's own skeleton (skeletons/<framework>/) wins
    [ -n "$fw" ] && [ -f "$KIT_DIR/stack/$stack/skeletons/$fw/$style.txt" ] && skel="$KIT_DIR/stack/$stack/skeletons/$fw/$style.txt"
    [ -f "$skel" ] || die "no '$style' skeleton for stack $stack${fw:++$fw} (available: $(ls "$KIT_DIR/stack/$stack/skeletons" 2>/dev/null | grep '\.txt$' | sed 's/\.txt$//' | tr '\n' ' '))"
    kebab="$(ascii_slug "$name" 40)"; snake="$(printf '%s' "$kebab" | tr '-' '_')"; flat="$(printf '%s' "$kebab" | tr -d '-')"
    pascal="$(printf '%s' "$kebab" | awk -F- '{for(i=1;i<=NF;i++) printf "%s%s", toupper(substr($i,1,1)), substr($i,2)}')"
    case "$stack" in java-*) mod="$flat" ;; python|dbt) mod="$snake" ;; *) mod="$kebab" ;; esac
    pkg="$(cfg base_package)"; pkgpath="$(printf '%s' "$pkg" | tr '.' '/')"
    if grep -q '{{package_path}}' "$skel" && [ -z "$pkg" ]; then die "set base_package in .agent/project.yaml (e.g. com.example.shop) first"; fi
    root="$KIT_ROOT"; [ "$cpath" != "." ] && root="$KIT_ROOT/$cpath"
    made=0
    while IFS= read -r line; do
      case "$line" in ''|'#'*) continue ;; esac
      path="$(printf '%s' "${line%%#*}" | sed 's/[[:space:]]*$//')"; note=""
      [ "${line#*#}" != "$line" ] && note="$(printf '%s' "${line#*#}" | sed 's/^[[:space:]]*//')"
      path="$(printf '%s' "$path" | sed -e "s#{{module}}#$mod#g" -e "s#{{Module}}#$pascal#g" -e "s#{{package_path}}#$pkgpath#g")"
      mkdir -p "$root/$path"
      if [ -n "$note" ] && [ ! -f "$root/$path/README.md" ]; then
        printf '# %s\n\n%s\n\nPart of module **%s** (%s, `%s` style — see .agent/stack/%s/skeletons/%s).\n' \
          "${path%/}" "$note" "$pascal" "$stack${fw:++$fw}" "$style" "$stack" "${skel##*/skeletons/}" > "$root/$path/README.md"
      fi
      echo "${cpath#.}${cpath:+/}${path}" | sed 's#^\./##; s#^/##'; made=$((made+1))
    done < "$skel"
    info "module $pascal ($style, $stack): $made folder(s). Next: kit-task for its first use case; architecture rules: ${skel#"$KIT_ROOT"/}"
    ;;

  doc)
    path="${1:-}"; shift || true; title="$*"
    [ -n "$path" ] && [ -n "$title" ] || die 'usage: kit-new doc <path.md> "<title>"'
    render "$TPL/living-doc.md" "$KIT_ROOT/$path" TITLE="$title" DATE="$(today)"
    ;;

  *)
    for p in "$KIT_DIR"/plugins/*/new-"${kind}".sh; do
      [ -f "$p" ] && { source "$p" "$@"; exit 0; }
    done
    [ -z "$kind" ] || [ "$kind" = -h ] || [ "$kind" = --help ] || die "unknown document kind '$kind' (install its module or see kit-new --help)"
    usage ;;
esac
