#!/usr/bin/env bash
# kit-context [--brief] [--topic <topic>] [TASK-ID]
# Print a compact context pack for ANY agent harness (Claude Code, DeepSeek Harness, Codex, ...).
# --brief : what a new session must know (used by the SessionStart hook), ~60 lines max.
# --topic <topic> : topic-based context (relevant lessons, ADRs matching topic/tag).
# default : brief + full task file + relevant/recent lessons + ADR index — paste into a fresh session.
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"

brief=0; id=""; topic=""
while [ $# -gt 0 ]; do
  case "$1" in
    --brief) brief=1; shift ;;
    --topic) topic="$2"; shift 2 ;;
    TASK-*) id="$1"; shift ;;
    *) shift ;;
  esac
done
[ -n "$id" ] || id="$(task_from_branch)"

section() { printf '\n### %s\n' "$1"; }
clip() { head -n "${2:-40}" "$1" 2>/dev/null; }

echo "## agent-kit context — $(cfg name "$(basename "$KIT_ROOT")") · $(now)"
echo "stack: $(cfg stack) · docs language: $(cfg docs_language vi) · branch: $(current_branch)"
is_protected "$(current_branch)" && echo "⚠ You are on a PROTECTED branch. Start a task first: .agent/scripts/kit-task start TASK-NNN"

section "STATE (.agent/memory/STATE.md)"
clip "$KIT_DIR/memory/STATE.md" 40

task_tags=""
if [ -n "$id" ]; then
  f="$(task_file "$id")"
  if [ -f "$f" ]; then
    section "ACTIVE TASK $id (${f#"$KIT_ROOT"/})"
    for p in "$KIT_DIR"/plugins/*/context.sh; do
      [ -f "$p" ] && ( source "$p" task "$f" ) || true
    done
    task_tags="$(norm_tags_re "$(fm_get "$f" tags 2>/dev/null)")"
    raw_task_tags="$(fm_get "$f" tags 2>/dev/null | tr -d '\r\t[]"'\'' ')"
    if [ $brief -eq 1 ]; then
      perl -0pe 's/<!--.*?-->//gs' "$f" | sed -n '/^## 1\. Understand/,/^## 3\. Solution/p' | grep -v '^[[:space:]]*$' | head -n 25
      echo "… (read the full task file before working)"
    else
      cat "$f"
    fi
  fi
fi

topic_re="$(norm_tags_re "$topic")"
query_tags="${topic_re:-$task_tags}"
display_tags="${topic:-${raw_task_tags:-$query_tags}}"
lessons_clean=""
[ -f "$KIT_DIR/memory/LESSONS.md" ] && lessons_clean="$(perl -0pe 's/<!--.*?-->//gs' "$KIT_DIR/memory/LESSONS.md" 2>/dev/null || true)"
if [ -n "$query_tags" ] && [ -n "$lessons_clean" ]; then
  matched_lessons="$(printf '%s\n' "$lessons_clean" | grep -iE "^- .*\[($query_tags)\]" || true)"
  if [ -n "$matched_lessons" ]; then
    section "TOPIC LESSONS (tags: [$display_tags] in .agent/memory/LESSONS.md)"
    echo "$matched_lessons" | head -n 10
  elif [ -n "$topic" ]; then
    section "TOPIC LESSONS ([$topic])"
    echo "No specific lessons recorded for [$topic]."
  fi
fi

n_lessons="$(printf '%s\n' "$lessons_clean" | grep -c '^- ' || true)"
if [ "${n_lessons:-0}" -gt 60 ]; then
  section "MAINTENANCE"
  echo "LESSONS.md has $n_lessons entries (append-only — never edit or delete them). Promote lessons that repeat into a rule in"
  echo ".agent/rules/project/ (enforced by a tool where possible) and rely on 'kit-context --topic <tag>' to load only the relevant ones."
fi

section "OPEN TASKS"
for t in "$KIT_TASKS"/TASK-*.md; do
  [ -f "$t" ] || continue
  st="$(fm_get "$t" status)"
  case "$st" in done|abandoned) continue ;; esac
  echo "- $(fm_get "$t" id) [$st] $(fm_get "$t" title)"
done | head -n 15 || true

if [ $brief -eq 0 ]; then
  if [ -n "$query_tags" ] && [ -d "$KIT_ROOT/docs/adr" ]; then
    matched_adrs="$(for a in "$KIT_ROOT"/docs/adr/[0-9]*.md; do [ -f "$a" ] || continue; basename "$a"; done | grep -iE "($query_tags)" || true)"
    if [ -n "$matched_adrs" ]; then
      section "TOPIC DECISIONS (matching [$display_tags] in docs/adr/)"
      printf '%s\n' "$matched_adrs" | sed 's/^/- /'
    fi
  fi

  section "RECENT LESSONS (tail of .agent/memory/LESSONS.md)"
  tail -n 15 "$KIT_DIR/memory/LESSONS.md" 2>/dev/null || true

  section "DECISIONS (docs/adr)"
  for a in "$KIT_ROOT"/docs/adr/[0-9]*.md; do
    [ -f "$a" ] || continue; case "$a" in *0000-*) continue ;; esac; echo "- $(basename "$a")"
  done
fi

section "READ ON DEMAND (do not load all at once)"
extra_refs=""
for p in "$KIT_DIR"/plugins/*/context.sh; do
  [ -f "$p" ] || continue
  r="$( ( source "$p" refs ) || true )"
  [ -n "$r" ] && extra_refs="$extra_refs · $r"
done
echo "- Docs map: docs/README.md · Workflow: .agent/rules/core/workflow.md${extra_refs}"
echo "- Goals/scope: .agent/context/PROJECT.md · Architecture: .agent/context/ARCHITECTURE.md · Rules: .agent/rules/"
echo "- Finished tasks live in .agent/tasks/archive/ — history only, do not read them to learn the system"
echo "- Conventions: .agent/context/CONVENTIONS.md · Playbooks: .agent/skills/<name>/SKILL.md"
