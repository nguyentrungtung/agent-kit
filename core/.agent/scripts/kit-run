#!/usr/bin/env bash
# kit-run <step...> — run project commands defined in .agent/project.yaml
# Steps: install format format_check lint typecheck arch test coverage specs trace dup build audit secrets docs ops sbom e2e perf api apigen up down logs
#        trace   = kit-trace (ids referenced in docs/specs/tasks exist; built in, no cmd_ needed)
#        testcov = coverage if cmd_coverage is set (fails under coverage_min), else test
#        check   = format_check lint typecheck arch test specs trace secrets   (before every commit/PR)
#        ci      = install format_check lint typecheck arch testcov specs trace dup secrets build audit   (what CI runs)
# Empty commands are skipped (not failed). Exit code != 0 if any step fails.
source "$(dirname "$0")/lib.sh"
cd "$KIT_ROOT"

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
[ $# -ge 1 ] || usage

tc() { if [ -n "$(cfg cmd_coverage)" ]; then echo coverage; else echo test; fi; }   # testcov resolution
expand() {
  local s out=()
  for s in "$@"; do
    case "$s" in
      check) out+=(format_check lint typecheck arch test specs trace secrets) ;;
      ci)    out+=(install format_check lint typecheck arch "$(tc)" specs trace dup secrets build audit) ;;
      testcov) out+=("$(tc)") ;;
      format-check) out+=(format_check) ;;
      *)     out+=("$s") ;;
    esac
  done
  printf '%s\n' "${out[@]}"
}

export KIT_COVERAGE_MIN="$(cfg coverage_min 70)"
failed=(); ran=0
for step in $(expand "$@"); do
  if [ "$step" = secrets ]; then
    cmd="\"$KIT_DIR/scripts/kit-secrets-scan\" --all"
  elif [ "$step" = trace ]; then
    cmd="\"$KIT_DIR/scripts/kit-trace\""
  else
    cmd="$(cfg "cmd_$step")"
  fi
  if [ -z "$cmd" ]; then
    printf '%s[skip]%s %-12s (cmd_%s empty in .agent/project.yaml)\n' "$c_dim" "$c_off" "$step" "$step"
    continue
  fi
  printf '%s[run ]%s %-12s %s\n' "$c_grn" "$c_off" "$step" "$cmd"
  ran=$((ran+1))
  if ! bash -c "$cmd"; then
    printf '%s[FAIL]%s %s\n' "$c_red" "$c_off" "$step"
    failed+=("$step")
  fi
done

if [ ${#failed[@]} -gt 0 ]; then
  die "failed steps: ${failed[*]}"
fi
info "OK ($ran step(s) ran)"
