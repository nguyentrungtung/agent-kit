#!/usr/bin/env bash
# agent-kit pre-push: never push to protected branches; run checks before pushing task branches
source "$(git rev-parse --show-toplevel)/.agent/scripts/lib.sh"
cd "$KIT_ROOT"
zero=0000000000000000000000000000000000000000
run_checks=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  case "$remote_ref" in refs/tags/*) continue ;; esac
  rb="${remote_ref#refs/heads/}"
  if is_protected "$rb"; then
    [ "${KIT_ALLOW_PROTECTED_PUSH:-}" = "i-am-human" ] || die "push to protected branch '$rb' is blocked — merge through a PR (humans: KIT_ALLOW_PROTECTED_PUSH=i-am-human)"
  fi
  [ "$local_sha" = "$zero" ] && continue   # deletion
  run_checks=1
done
if [ $run_checks -eq 1 ]; then
  steps="$(cfg prepush_checks 'lint test')"
  [ -n "$steps" ] && { info "pre-push checks: $steps"; "$KIT_DIR/scripts/kit-run" $steps; }
fi
exit 0
